{
  "name": "@paybrain/database",
  "version": "1.0.0",
  "private": true,
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "scripts": {
    "build": "tsc",
    "dev": "tsc --watch",
    "lint": "tsc --noEmit",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:push": "prisma db push --skip-generate",
    "db:migrate:dev": "prisma migrate dev",
    "db:ledger-cents": "node sql/migrate-ledger-to-cents.mjs",
    "db:merchant-email": "node sql/migrate-merchant-email.mjs",
    "db:studio": "prisma studio",
    "db:triggers": "node sql/apply-triggers.mjs",
    "db:seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@paybrain/shared": "*",
    "@prisma/client": "^6.9.0",
    "argon2": "^0.41.1",
    "prisma": "^6.9.0"
  },
  "devDependencies": {
    "typescript": "^5.8.3",
    "ts-node": "^10.9.2",
    "@types/node": "^22.15.29"
  }
}
