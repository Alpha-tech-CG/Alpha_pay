generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REJECTED
}

enum Operator {
  MTN
  AIRTEL
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  DEAD
}

enum AccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
  EQUITY
}

enum EntryDirection {
  DEBIT
  CREDIT
}

enum WebhookInboundStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
}

enum ApiKeyMode {
  TEST
  LIVE
}

enum WebhookEndpointStatus {
  ACTIVE
  DISABLED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

model Merchant {
  id           String        @id @default(uuid())
  name         String
  email        String        @unique
  apiKey       String        @unique @map("api_key")
  isActive     Boolean       @default(true) @map("is_active")
  createdAt    DateTime      @default(now()) @map("created_at")
  updatedAt    DateTime      @updatedAt @map("updated_at")
  transactions Transaction[]
  paymentLinks PaymentLink[]
  apiKeys      ApiKey[]
  webhookEndpoints WebhookEndpoint[]

  @@map("merchants")
}

// Clés API marchand (ALP-136). Secret haché (scrypt) — affiché une seule fois
// à la création. Lookup par prefix unique, puis vérification du secret.
model ApiKey {
  id           String     @id @default(uuid())
  merchantId   String     @map("merchant_id")
  merchant     Merchant   @relation(fields: [merchantId], references: [id])
  name         String
  mode         ApiKeyMode @default(TEST)
  prefix       String     @unique
  hashedSecret String     @map("hashed_secret")
  scopes       String[]   @default([])
  ipAllowlist  String[]   @default([]) @map("ip_allowlist")
  lastUsedAt   DateTime?  @map("last_used_at")
  revokedAt    DateTime?  @map("revoked_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([merchantId])
  @@map("api_keys")
}

// Endpoints webhook sortants déclarés par le marchand (ALP-132 / ALP-136).
model WebhookEndpoint {
  id         String                @id @default(uuid())
  merchantId String                @map("merchant_id")
  merchant   Merchant              @relation(fields: [merchantId], references: [id])
  url        String
  events     String[]              @default([])
  secret     String // secret de signature HMAC propre à l'endpoint
  status     WebhookEndpointStatus @default(ACTIVE)
  createdAt  DateTime              @default(now()) @map("created_at")
  deliveries WebhookDelivery[]

  @@index([merchantId])
  @@map("webhook_endpoints")
}

// Tentatives de livraison webhook sortantes (ALP-132). Payload + réponse stockés
// pour debug ; retry programmé via nextRetryAt (30s, 2m, 10m, 1h, 6h, 24h).
model WebhookDelivery {
  id             String                @id @default(uuid())
  endpointId     String                @map("endpoint_id")
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id])
  event          String
  webhookId      String                @unique @map("webhook_id")
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  responseStatus Int?                  @map("response_status")
  responseBody   String?               @map("response_body")
  lastError      String?               @map("last_error")
  nextRetryAt    DateTime              @default(now()) @map("next_retry_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  @@index([status, nextRetryAt])
  @@index([endpointId])
  @@map("webhook_deliveries")
}

model Transaction {
  id               String            @id @default(uuid())
  merchantId       String            @map("merchant_id")
  merchant         Merchant          @relation(fields: [merchantId], references: [id])
  mtnReferenceId   String?           @map("mtn_reference_id")
  operator         Operator          @default(MTN)
  externalId       String            @map("external_id")
  amount           Decimal           @db.Decimal(15, 2)
  currency         String            @default("XAF")
  payerPhone       String            @map("payer_phone")
  status           TransactionStatus @default(PENDING)
  payerMessage     String?           @map("payer_message")
  failureReason    String?           @map("failure_reason")
  retryCount       Int               @default(0) @map("retry_count")
  version          Int               @default(0)
  createdAt        DateTime          @default(now()) @map("created_at")
  updatedAt        DateTime          @updatedAt @map("updated_at")
  webhookLogs      WebhookLog[]
  outboxEvents     OutboxEvent[]
  audits           TransactionAudit[]

  @@unique([merchantId, externalId])
  @@index([status])
  @@index([merchantId])
  @@index([externalId])
  @@index([mtnReferenceId])
  @@map("transactions")
}

// Journal d'audit des transitions de statut de transaction (ALP-167).
model TransactionAudit {
  id            String      @id @default(uuid())
  transactionId String      @map("transaction_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  fromStatus    String      @map("from_status")
  toStatus      String      @map("to_status")
  reason        String?
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([transactionId])
  @@map("transaction_audits")
}

model OutboxEvent {
  id            String       @id @default(uuid())
  transactionId String       @map("transaction_id")
  transaction   Transaction  @relation(fields: [transactionId], references: [id])
  type          String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  maxAttempts   Int          @default(5) @map("max_attempts")
  lastError     String?      @map("last_error")
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

model WebhookLog {
  id               String      @id @default(uuid())
  transactionId    String?     @map("transaction_id")
  transaction      Transaction? @relation(fields: [transactionId], references: [id])
  mtnReferenceId   String?     @map("mtn_reference_id")
  event            String
  payload          Json
  processedAt      DateTime    @default(now()) @map("processed_at")

  @@map("webhooks_log")
}

model PaymentLink {
  id          String    @id @default(uuid())
  merchantId  String    @map("merchant_id")
  merchant    Merchant  @relation(fields: [merchantId], references: [id])
  amount      Decimal   @db.Decimal(15, 2)
  currency    String    @default("XAF")
  description String
  expiresAt   DateTime? @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("payment_links")
}

// Déduplication des webhooks entrants (ALP-157 + ALP-158).
// Garantit qu'un même event operator ne déclenche le traitement qu'une seule fois.
model WebhookInboundEvent {
  id              String               @id @default(uuid())
  operator        Operator
  providerEventId String               @map("provider_event_id")
  signatureHex    String               @map("signature_hex")
  timestampEpoch  Int                  @map("timestamp_epoch")
  rawPayload      Json                 @map("raw_payload")
  status          WebhookInboundStatus @default(RECEIVED)
  createdAt       DateTime             @default(now()) @map("created_at")

  @@unique([operator, providerEventId])
  @@map("webhook_inbound_events")
}

// Idempotence sur POST /payments (ALP-156).
// Mémorise la réponse 24h pour rejouer à l'identique si le marchand retente.
model IdempotencyRecord {
  id             String    @id @default(uuid())
  merchantId     String    @map("merchant_id")
  idempotencyKey String    @map("idempotency_key")
  endpoint       String
  requestHash    Bytes     @map("request_hash")
  lockedUntil    DateTime? @map("locked_until")
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")

  @@unique([merchantId, idempotencyKey, endpoint])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// Liste d'attente du site marketing (ALP-133).
model WaitlistEntry {
  id        String   @id @default(uuid())
  email     String   @unique
  locale    String   @default("fr")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("waitlist_entries")
}

// Messages du formulaire de contact (ALP-133).
model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

// Grand livre comptable en partie double. Source de vérité financière :
// immutable et auditable via chaînage cryptographique (cf. LedgerService).
model LedgerAccount {
  id         String         @id @default(uuid())
  merchantId String?        @map("merchant_id")
  name       String
  type       AccountType
  createdAt  DateTime       @default(now()) @map("created_at")
  entries    JournalEntry[]
  snapshots  LedgerBalanceSnapshot[]

  @@unique([merchantId, name])
  @@map("ledger_accounts")
}

// Lignes d'écriture immuables. Aucune opération UPDATE/DELETE n'est exposée
// par LedgerService sur ce modèle — toute correction se fait par contre-écriture.
model JournalEntry {
  id            String         @id @default(uuid())
  sequence      BigInt         @default(autoincrement())
  transactionId String         @map("transaction_id")
  accountId     String         @map("account_id")
  account       LedgerAccount  @relation(fields: [accountId], references: [id])
  direction     EntryDirection
  amount        Decimal        @db.Decimal(15, 2)
  currency      String
  description   String?
  prevHash      String         @map("prev_hash")
  hash          String
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([accountId])
  @@index([transactionId])
  @@index([sequence])
  @@map("journal_entries")
}

model LedgerBalanceSnapshot {
  id           String        @id @default(uuid())
  accountId    String        @map("account_id")
  account      LedgerAccount @relation(fields: [accountId], references: [id])
  balance      Decimal       @db.Decimal(15, 2)
  asOfSequence BigInt        @map("as_of_sequence")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([accountId, asOfSequence])
  @@map("ledger_balance_snapshots")
}
