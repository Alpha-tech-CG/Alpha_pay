generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// Statuts unifiés AlphaPay (§M3, D-016). Libellés publics : en_attente,
// réussi, échoué, expiré, annulé.
enum TransactionStatus {
  PENDING
  SUCCEEDED
  FAILED
  EXPIRED
  CANCELED
}

enum Operator {
  MTN
  AIRTEL
  CINETPAY
  WALLET
  BANK
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  DEAD
}

enum WebhookInboundStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
}

enum ApiKeyMode {
  TEST
  LIVE
}

enum WebhookEndpointStatus {
  ACTIVE
  DISABLED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ReconciliationDiscrepancyType {
  LEDGER_NOT_IN_STATEMENT
  STATEMENT_NOT_IN_LEDGER
  AMOUNT_MISMATCH
  DUPLICATE
}

enum NotificationChannel {
  SMS
  EMAIL
  WEBHOOK
}

enum NotificationStatus {
  SENT
  DELIVERED
  FAILED
  SKIPPED
}



enum OnboardingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MerchantType {
  MERCHANT
  DEVELOPER
}

model Merchant {
  id                  String                @id @default(uuid())
  name                String
  emailEncrypted      Bytes                 @map("email_encrypted")
  emailHash           Bytes                 @unique @map("email_hash")
  phone               String?
  companyName         String?               @map("company_name")
  country             String?
  website             String?
  useCase             String?               @map("use_case")
  idDocumentKey       String?               @map("id_document_key")
  merchantType        MerchantType          @default(MERCHANT) @map("merchant_type")
  onboardingStatus    OnboardingStatus      @default(PENDING) @map("onboarding_status")
  rejectionReason     String?               @map("rejection_reason")
  isActive            Boolean               @default(false) @map("is_active")
  ownerUserId         String?               @map("owner_user_id")
  createdAt           DateTime              @default(now()) @map("created_at")
  updatedAt           DateTime              @updatedAt @map("updated_at")
  transactions        Transaction[]
  paymentLinks        PaymentLink[]
  apiKeys             ApiKey[]
  webhookEndpoints    WebhookEndpoint[]
  owner               AppUser?              @relation("MerchantOwner", fields: [ownerUserId], references: [id])
  members             MerchantMember[]
  invitations         MerchantInvitation[]
  memberEvents        MerchantMemberEvent[]
  providerConnections ProviderConnection[]
  stores              Store[]
  kybApplication      KybApplication?
  cashEntries         CashEntry[]
  reconciliationDays  ReconciliationDay[]
  exportJobs          ExportJob[]
  customers           Customer[]
  invoices            Invoice[]
  receipts            Receipt[]
  invoiceCounter      InvoiceCounter?
  schoolYears         SchoolYear[]
  schoolClasses       SchoolClass[]
  students            Student[]
  guardians           Guardian[]
  feeGrids            FeeGrid[]
  studentFeeSchedules StudentFeeSchedule[]

  @@index([onboardingStatus])
  @@map("merchants")
}

// Clés API marchand (ALP-136). Secret haché (scrypt) — affiché une seule fois
// à la création. Lookup par prefix unique, puis vérification du secret.
model ApiKey {
  id           String     @id @default(uuid())
  merchantId   String     @map("merchant_id")
  merchant     Merchant   @relation(fields: [merchantId], references: [id])
  name         String
  mode         ApiKeyMode @default(TEST)
  prefix       String     @unique
  hashedSecret String     @map("hashed_secret")
  scopes       String[]   @default([])
  ipAllowlist  String[]   @default([]) @map("ip_allowlist")
  lastUsedAt   DateTime?  @map("last_used_at")
  revokedAt    DateTime?  @map("revoked_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([merchantId])
  @@map("api_keys")
}

// Endpoints webhook sortants déclarés par le marchand (ALP-132 / ALP-136).
model WebhookEndpoint {
  id         String                @id @default(uuid())
  merchantId String                @map("merchant_id")
  // Mode test ou live (§4.6) : jamais mélangés.
  livemode   Boolean               @default(false)
  merchant   Merchant              @relation(fields: [merchantId], references: [id])
  url        String
  events     String[]              @default([])
  secret     String // secret de signature HMAC propre à l'endpoint
  status     WebhookEndpointStatus @default(ACTIVE)
  createdAt  DateTime              @default(now()) @map("created_at")
  deliveries WebhookDelivery[]

  @@index([merchantId, livemode])
  @@map("webhook_endpoints")
}

// Tentatives de livraison webhook sortantes (ALP-132). Payload + réponse stockés
// pour debug ; retry programmé via nextRetryAt (30s, 2m, 10m, 1h, 6h, 24h).
model WebhookDelivery {
  id             String                @id @default(uuid())
  endpointId     String                @map("endpoint_id")
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id])
  event          String
  webhookId      String                @unique @map("webhook_id")
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  responseStatus Int?                  @map("response_status")
  responseBody   String?               @map("response_body")
  lastError      String?               @map("last_error")
  nextRetryAt    DateTime              @default(now()) @map("next_retry_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  @@index([status, nextRetryAt])
  @@index([endpointId])
  @@map("webhook_deliveries")
}

model Transaction {
  id             String             @id @default(uuid())
  merchantId     String             @map("merchant_id")
  merchant       Merchant           @relation(fields: [merchantId], references: [id])
  mtnReferenceId String?            @map("mtn_reference_id")
  operator       Operator           @default(MTN)
  // Mode test (sandbox/mocks) ou live (§4.6) : jamais mélangés.
  livemode       Boolean            @default(false)
  // Point d'encaissement (§M6) : boutique et caisse, si le paiement vient d'une caisse.
  storeId        String?            @map("store_id")
  tillId         String?            @map("till_id")
  // Lien de paiement d'origine (§M4), le cas échéant.
  paymentLinkId  String?            @map("payment_link_id")
  paymentLink    PaymentLink?       @relation(fields: [paymentLinkId], references: [id])
  externalId     String             @map("external_id")
  // Montant en unités mineures de la devise (BIGINT, D-007) : XAF = francs entiers, EUR = centimes.
  amount         BigInt
  currency       String             @default("XAF")
  // PII chiffrée (ALP-164) : numéro jamais en clair en base.
  payerPhoneEnc  Bytes?             @map("payer_phone_enc")
  payerPhoneHash Bytes?             @map("payer_phone_hash")
  payerPhoneMask String?            @map("payer_phone_mask")
  status         TransactionStatus  @default(PENDING)
  payerMessage   String?            @map("payer_message")
  failureReason  String?            @map("failure_reason")
  retryCount     Int                @default(0) @map("retry_count")
  version        Int                @default(0)
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  webhookLogs    WebhookLog[]
  outboxEvents   OutboxEvent[]
  audits         TransactionAudit[]

  @@unique([merchantId, livemode, externalId])
  @@index([status])
  @@index([merchantId])
  @@index([externalId])
  @@index([mtnReferenceId])
  @@index([payerPhoneHash])
  @@index([merchantId, livemode, createdAt])
  @@index([tillId, livemode, createdAt])
  @@index([paymentLinkId])
  @@map("transactions")
}

// Journal d'audit des transitions de statut de transaction (ALP-167).
model TransactionAudit {
  id            String      @id @default(uuid())
  transactionId String      @map("transaction_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  fromStatus    String      @map("from_status")
  toStatus      String      @map("to_status")
  reason        String?
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([transactionId])
  @@map("transaction_audits")
}

model OutboxEvent {
  id            String       @id @default(uuid())
  transactionId String       @map("transaction_id")
  transaction   Transaction  @relation(fields: [transactionId], references: [id])
  type          String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  maxAttempts   Int          @default(5) @map("max_attempts")
  lastError     String?      @map("last_error")
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

model WebhookLog {
  id             String       @id @default(uuid())
  transactionId  String?      @map("transaction_id")
  transaction    Transaction? @relation(fields: [transactionId], references: [id])
  mtnReferenceId String?      @map("mtn_reference_id")
  event          String
  payload        Json
  processedAt    DateTime     @default(now()) @map("processed_at")

  @@map("webhooks_log")
}

model PaymentLink {
  id          String    @id @default(uuid())
  merchantId  String    @map("merchant_id")
  // Mode test ou live (§4.6) : jamais mélangés.
  livemode    Boolean   @default(false)
  merchant    Merchant  @relation(fields: [merchantId], references: [id])
  // Montant fixe en unités mineures (D-007) ; null = montant libre saisi par le payeur (§M4).
  amount      BigInt?
  currency    String    @default("XAF")
  description String
  // Code public de l'URL hébergée (/l/<code>), sans caractère ambigu.
  publicCode  String?   @unique @map("public_code")
  code        String?   @unique @map("ussd_code") // code court composable en USSD (téléphones à touches)
  multiUse    Boolean   @default(false) @map("multi_use")
  active      Boolean   @default(true)
  expiresAt   DateTime? @map("expires_at")
  // Usage unique : date du paiement réussi qui a consommé le lien.
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")
  payments    Transaction[]

  @@index([merchantId, livemode, createdAt])
  @@map("payment_links")
}

// Déduplication des webhooks entrants (ALP-157 + ALP-158).
// Garantit qu'un même event operator ne déclenche le traitement qu'une seule fois.
model WebhookInboundEvent {
  id              String               @id @default(uuid())
  operator        Operator
  providerEventId String               @map("provider_event_id")
  signatureHex    String               @map("signature_hex")
  timestampEpoch  Int                  @map("timestamp_epoch")
  rawPayload      Json                 @map("raw_payload")
  status          WebhookInboundStatus @default(RECEIVED)
  createdAt       DateTime             @default(now()) @map("created_at")

  @@unique([operator, providerEventId])
  @@map("webhook_inbound_events")
}

// Idempotence sur POST /payments (ALP-156).
// Mémorise la réponse 24h pour rejouer à l'identique si le marchand retente.
model IdempotencyRecord {
  id             String    @id @default(uuid())
  merchantId     String    @map("merchant_id")
  // Mode test ou live (§4.6) : jamais mélangés.
  livemode       Boolean   @default(false)
  idempotencyKey String    @map("idempotency_key")
  endpoint       String
  requestHash    Bytes     @map("request_hash")
  lockedUntil    DateTime? @map("locked_until")
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")

  @@unique([merchantId, livemode, idempotencyKey, endpoint])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// Liste d'attente du site marketing (ALP-133).
model WaitlistEntry {
  id        String   @id @default(uuid())
  email     String   @unique
  locale    String   @default("fr")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("waitlist_entries")
}

// Messages du formulaire de contact (ALP-133).
model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

// Pipeline KYC marchand (ALP-142). Conservation 10 ans (réglementaire).



// Notifications multi-canal (ALP-143).
model NotificationLog {
  id                String              @id @default(uuid())
  channel           NotificationChannel
  recipient         String
  template          String
  templateVersion   String              @map("template_version")
  category          String
  status            NotificationStatus
  provider          String?
  providerMessageId String?             @map("provider_message_id")
  attempts          Int                 @default(1)
  error             String?
  deliveredAt       DateTime?           @map("delivered_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([channel, status])
  @@index([provider, providerMessageId])
  @@map("notification_logs")
}

// Préférences marchand : opt-out par (catégorie, canal). Absence = opt-in.
model NotificationPreference {
  id         String              @id @default(uuid())
  merchantId String              @map("merchant_id")
  category   String
  channel    NotificationChannel
  optedOut   Boolean             @default(false) @map("opted_out")

  @@unique([merchantId, category, channel])
  @@map("notification_preferences")
}

// Réconciliation : un run rapproche un relevé opérateur du ledger interne (ALP-140).
model ReconciliationRun {
  id               String                      @id @default(uuid())
  operator         Operator
  statementDate    DateTime                    @map("statement_date")
  statementLines   Int                         @map("statement_lines")
  matchedCount     Int                         @map("matched_count")
  discrepancyCount Int                         @map("discrepancy_count")
  totalStatement   BigInt                      @map("total_statement") // XAF (unités mineures)
  totalLedger      BigInt                      @map("total_ledger") // XAF (unités mineures)
  maxDiscrepancy   BigInt                      @map("max_discrepancy") // XAF (unités mineures)
  alert            Boolean                     @default(false) // true si écart > seuil P1
  reportJson       Json                        @map("report_json")
  reportJsonKey    String?                     @map("report_json_key")
  reportPdfKey     String?                     @map("report_pdf_key")
  archivedAt       DateTime?                   @map("archived_at")
  createdAt        DateTime                    @default(now()) @map("created_at")
  discrepancies    ReconciliationDiscrepancy[]

  @@index([operator, statementDate])
  @@map("reconciliation_runs")
}

model ReconciliationDiscrepancy {
  id              String                        @id @default(uuid())
  runId           String                        @map("run_id")
  run             ReconciliationRun             @relation(fields: [runId], references: [id])
  type            ReconciliationDiscrepancyType
  reference       String
  ledgerAmount    BigInt?                       @map("ledger_amount") // XAF (unités mineures)
  statementAmount BigInt?                       @map("statement_amount") // XAF (unités mineures)
  details         String?

  @@index([runId])
  @@map("reconciliation_discrepancies")
}

// Tokens push Expo pour notifications marchands (ALP-150).
model PushToken {
  id         String   @id @default(uuid())
  merchantId String   @map("merchant_id")
  token      String
  platform   String   @default("expo")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([merchantId, token])
  @@index([merchantId])
  @@map("push_tokens")
}

// ─────────────────────────────────────────────────────────────────────────
// Équipe marchand / multi-tenant (ALP-team). Un utilisateur peut appartenir à
// plusieurs marchands avec un rôle par marchand. Identité locale = AppUser
// (miroir Clerk, alimenté par le webhook Clerk). Voir migrations 13/14.
// ─────────────────────────────────────────────────────────────────────────

enum MerchantMemberRole {
  OWNER // Propriétaire : tout, y compris facturation, opérateurs, suppression
  ADMIN // Administrateur : tout sauf facturation et suppression du compte
  ACCOUNTANT // Comptable : transactions, rapprochement, exports, factures (lecture)
  CASHIER // Caissier : encaisse, ne voit que sa caisse, reçoit Vérif
  DEVELOPER // Développeur : clés API, webhooks, journaux d'API
}

enum MerchantMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum MerchantMemberEventType {
  INVITATION_SENT
  INVITATION_ACCEPTED
  INVITATION_REVOKED
  ROLE_CHANGED
  MEMBER_SUSPENDED
  MEMBER_REACTIVATED
  MEMBER_REMOVED
  OWNERSHIP_TRANSFERRED
}

/// Utilisateur local (miroir Clerk). PII chiffrée comme Merchant.
model AppUser {
  id                  String         @id @default(uuid())
  emailEncrypted      Bytes          @map("email_encrypted")
  emailHash           Bytes          @unique @map("email_hash")
  fullName            String?        @map("full_name")
  // Téléphone E.164 chiffré + haché (recherche) + masqué (affichage).
  phoneEncrypted      Bytes?         @map("phone_encrypted")
  phoneHash           Bytes?         @unique @map("phone_hash")
  phoneMasked         String?        @map("phone_masked")
  // Mot de passe haché Argon2id (§M1) ; jamais en clair, jamais journalisé.
  passwordHash        String?        @map("password_hash")
  emailVerifiedAt     DateTime?      @map("email_verified_at")
  phoneVerifiedAt     DateTime?      @map("phone_verified_at")
  preferredOtpChannel MessageChannel @default(SMS) @map("preferred_otp_channel")
  status              UserStatus     @default(ACTIVE)
  lastLoginAt         DateTime?      @map("last_login_at")
  createdAt           DateTime       @default(now()) @map("created_at")
  updatedAt           DateTime       @updatedAt @map("updated_at")

  memberships     MerchantMember[]
  invitationsSent MerchantInvitation[]  @relation("InvitedBy")
  memberEvents    MerchantMemberEvent[] @relation("Actor")
  ownedMerchants  Merchant[]            @relation("MerchantOwner")
  sessions        Session[]

  @@map("app_users")
}

/// Appartenance d'un utilisateur à un marchand (source de vérité).
model MerchantMember {
  id          String               @id @default(uuid())
  merchantId  String               @map("merchant_id")
  userId      String               @map("user_id")
  role        MerchantMemberRole   @default(CASHIER)
  status      MerchantMemberStatus @default(INVITED)
  invitedAt   DateTime?            @map("invited_at")
  joinedAt    DateTime?            @map("joined_at")
  suspendedAt DateTime?            @map("suspended_at")
  removedAt   DateTime?            @map("removed_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  tills    TillMember[]
  pushSubscriptions WebPushSubscription[]
  cashEntries       CashEntry[]
  reconReviews      ReconciliationDay[]  @relation("ReconciliationReviewer")
  exportRequests    ExportJob[]          @relation("ExportRequester")
  merchant Merchant     @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user     AppUser      @relation(fields: [userId], references: [id])

  // NB : un index unique PARTIEL « un seul OWNER actif par marchand » est créé
  // dans la migration SQL (Prisma ne gère pas les index partiels).
  @@unique([merchantId, userId])
  @@index([merchantId, status])
  @@index([userId, status])
  @@map("merchant_members")
}

/// Invitation par e-mail. Token JAMAIS stocké en clair (SHA-256).
model MerchantInvitation {
  id             String             @id @default(uuid())
  merchantId     String             @map("merchant_id")
  // Invitation par email ou par téléphone (au moins l'un des deux).
  emailHash      Bytes?             @map("email_hash")
  emailEncrypted Bytes?             @map("email_encrypted")
  phoneHash      Bytes?             @map("phone_hash")
  phoneEncrypted Bytes?             @map("phone_encrypted")
  role           MerchantMemberRole @default(CASHIER)
  tokenHash      String             @unique @map("token_hash")
  invitedById    String             @map("invited_by")
  expiresAt      DateTime           @map("expires_at")
  acceptedAt     DateTime?          @map("accepted_at")
  revokedAt      DateTime?          @map("revoked_at")
  createdAt      DateTime           @default(now()) @map("created_at")

  merchant  Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  invitedBy AppUser  @relation("InvitedBy", fields: [invitedById], references: [id])

  // Index partiel « une seule invitation en attente par (marchand,email) » → migration SQL.
  @@index([merchantId])
  @@map("merchant_invitations")
}

/// Journal d'audit append-only des actions d'équipe.
model MerchantMemberEvent {
  id          String                  @id @default(uuid())
  merchantId  String                  @map("merchant_id")
  memberId    String?                 @map("member_id")
  actorUserId String?                 @map("actor_user_id")
  eventType   MerchantMemberEventType @map("event_type")
  metadata    Json                    @default("{}")
  createdAt   DateTime                @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  actor    AppUser? @relation("Actor", fields: [actorUserId], references: [id])

  @@index([merchantId, createdAt])
  @@map("merchant_member_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// ORCHESTRATION (migration 17) — modèle « fournisseur de technologie de paiement »
// AlphaPay orchestre entre partenaires (banques, MNO, réseaux carte) SANS jamais
// détenir les fonds. Les entités ci-dessous sont des règles/instructions/miroirs,
// aucun compte ne « détient » de la valeur.
// ─────────────────────────────────────────────────────────────────────────────

enum ProviderConnectionStatus {
  PENDING // en attente de connexion (identifiants non saisis ou non vérifiés)
  ACTIVE
  DISABLED
}

// Connexion du marchand à SON compte opérateur (§4.3, D-006). Les identifiants
// API sont chiffrés (AES-256-GCM, clé maîtresse PROVIDER_CREDENTIALS_KEY hors
// base) : chaque paiement part avec eux, les fonds arrivent chez le marchand.
model ProviderConnection {
  id             String                   @id @default(uuid())
  merchantId     String                   @map("merchant_id")
  merchant       Merchant                 @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  operator       Operator
  livemode       Boolean                  @default(false)
  environment    String // "sandbox" | "production"
  credentialsEnc Bytes?                   @map("credentials_enc")
  status         ProviderConnectionStatus @default(PENDING)
  lastVerifiedAt DateTime?                @map("last_verified_at")
  createdAt      DateTime                 @default(now()) @map("created_at")
  updatedAt      DateTime                 @updatedAt @map("updated_at")

  @@unique([merchantId, operator, livemode])
  @@map("provider_connections")
}

// ─── M9 Messages et OTP (T-20) ───────────────────────────────────────────────

enum MessageChannel {
  SMS
  WHATSAPP
  EMAIL
}

enum MessageStatus {
  QUEUED // en file, pas encore remis au fournisseur
  SENT // accepté par le fournisseur
  DELIVERED
  READ
  FAILED
  SKIPPED // non envoyé (désabonnement, préférence)
}

enum MessageCategory {
  TRANSACTIONAL // reçus, confirmations, relances de paiement
  OTP
  MARKETING // soumis au désabonnement (STOP)
}

// Modèle de message versionné (§M9) : une nouvelle version = une nouvelle
// ligne, l'ancienne reste pour l'historique des messages envoyés.
model MessageTemplate {
  id                   String          @id @default(uuid())
  key                  String // ex. "otp.connexion", "verif.paiement_recu"
  channel              MessageChannel
  locale               String          @default("fr")
  version              Int
  category             MessageCategory
  subject              String? // email
  body                 String // texte avec variables {{nom}}
  // WhatsApp : nom et langue du modèle pré-approuvé chez Meta ; les variables
  // sont passées dans l'ordre de `variables`.
  whatsappTemplateName String?         @map("whatsapp_template_name")
  variables            String[]        @default([])
  active               Boolean         @default(true)
  createdAt            DateTime        @default(now()) @map("created_at")

  @@unique([key, channel, locale, version])
  @@index([key, channel, locale, active])
  @@map("message_templates")
}

// Journal de chaque message (§M9) : destination masquée et hachée, jamais en
// clair ; contact et variables ne sont conservés que chiffrés, le temps de
// l'envoi, puis effacés (un OTP n'apparaît jamais dans les journaux ni en clair).
model Message {
  id                String           @id @default(uuid())
  // null = message interne d'AlphaPay (OTP de connexion, alertes).
  merchantId        String?          @map("merchant_id")
  livemode          Boolean          @default(false)
  channel           MessageChannel
  category          MessageCategory
  templateKey       String?          @map("template_key")
  templateVersion   Int?             @map("template_version")
  destinationHash   Bytes            @map("destination_hash")
  destinationMasked String           @map("destination_masked")
  // Contact chiffré { phone?, email? } : permet la bascule vers un autre canal.
  contactEnc        Bytes?           @map("contact_enc")
  subject           String?
  // Variables du modèle, chiffrées, rendues au moment de l'envoi ; effacées
  // dès que le message est livré ou définitivement en échec.
  variablesEnc      Bytes?           @map("variables_enc")
  status            MessageStatus    @default(QUEUED)
  provider          String?
  providerMessageId String?          @map("provider_message_id")
  attempts          Int              @default(0)
  maxAttempts       Int              @default(5) @map("max_attempts")
  lastError         String?          @map("last_error")
  costMinor         BigInt?          @map("cost_minor")
  costCurrency      String?          @map("cost_currency")
  creditsCharged    Int              @default(0) @map("credits_charged")
  // Bascule de canal : canaux restant à essayer, et message d'origine.
  fallbackChannels  MessageChannel[] @default([]) @map("fallback_channels")
  fallbackOfId      String?          @map("fallback_of_id")
  // Groupe de bascule : tous les essais d'un même envoi logique.
  groupId           String           @map("group_id")
  sentAt            DateTime?        @map("sent_at")
  deliveredAt       DateTime?        @map("delivered_at")
  readAt            DateTime?        @map("read_at")
  failedAt          DateTime?        @map("failed_at")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@index([merchantId, livemode, createdAt])
  @@index([provider, providerMessageId])
  @@index([status, createdAt])
  @@index([groupId])
  @@map("messages")
}

// Préférences de canal d'un destinataire, par marchand (ordre d'essai).
model MessagePreference {
  id                String           @id @default(uuid())
  merchantId        String?          @map("merchant_id")
  destinationHash   Bytes            @map("destination_hash")
  preferredChannels MessageChannel[] @map("preferred_channels")
  createdAt         DateTime         @default(now()) @map("created_at")
  updatedAt         DateTime         @updatedAt @map("updated_at")

  @@unique([merchantId, destinationHash])
  @@map("message_preferences")
}

// Désabonnement (réponse STOP) : bloque les messages MARKETING vers ce
// destinataire, jamais les messages transactionnels ni les OTP.
model OptOut {
  id              String         @id @default(uuid())
  merchantId      String?        @map("merchant_id")
  channel         MessageChannel
  destinationHash Bytes          @map("destination_hash")
  source          String // "STOP" | "manuel"
  createdAt       DateTime       @default(now()) @map("created_at")

  @@unique([merchantId, channel, destinationHash])
  @@map("opt_outs")
}

// Audit des OTP : jamais le code, seulement les événements.
model OtpAudit {
  id                String          @id @default(uuid())
  merchantId        String?         @map("merchant_id")
  livemode          Boolean         @default(false)
  purpose           String
  channel           MessageChannel?
  destinationHash   Bytes           @map("destination_hash")
  destinationMasked String          @map("destination_masked")
  // sent | verified | invalid | expired | locked | rate_limited | cooldown
  event             String
  ipHash            Bytes?          @map("ip_hash")
  createdAt         DateTime        @default(now()) @map("created_at")

  @@index([destinationHash, createdAt])
  @@index([merchantId, livemode, createdAt])
  @@map("otp_audit")
}

// Registre des crédits de messages (§6, M11) : en ajout seul, jamais modifié ;
// le solde est la somme des mouvements. Achat de packs : M11 (T-82).
model CreditLedger {
  id         String   @id @default(uuid())
  merchantId String   @map("merchant_id")
  livemode   Boolean  @default(false)
  // Positif = crédit (achat, remboursement), négatif = consommation.
  delta      Int
  reason     String // "achat" | "message" | "remboursement" | "ajustement"
  messageId  String?  @map("message_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([merchantId, livemode, createdAt])
  @@index([messageId])
  @@map("credit_ledger")
}

// ─── M1 Comptes (T-30) ───────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  DISABLED
}

// Session de connexion (§M1) : jeton d'accès court (JWT) + jeton de
// rafraîchissement opaque, stocké haché et renouvelé à chaque usage. Rejouer
// un ancien jeton révoque la session (vol présumé).
model Session {
  id                String    @id @default(uuid())
  userId            String    @map("user_id")
  user              AppUser   @relation(fields: [userId], references: [id], onDelete: Cascade)
  refreshTokenHash  String    @unique @map("refresh_token_hash")
  previousTokenHash String?   @unique @map("previous_token_hash")
  userAgent         String?   @map("user_agent")
  ipHash            Bytes?    @map("ip_hash")
  createdAt         DateTime  @default(now()) @map("created_at")
  lastUsedAt        DateTime  @default(now()) @map("last_used_at")
  expiresAt         DateTime  @map("expires_at")
  revokedAt         DateTime? @map("revoked_at")
  revokedReason     String?   @map("revoked_reason")

  @@index([userId, revokedAt])
  @@map("sessions")
}

// Journal d'audit non modifiable (§M12) : qui a fait quoi, quand, depuis
// quelle adresse IP. Ajout seul (triggers Postgres). Complété par T-94.
model AuditLog {
  id         String   @id @default(uuid())
  // user | staff | api_key | system
  actorType  String   @map("actor_type")
  actorId    String?  @map("actor_id")
  merchantId String?  @map("merchant_id")
  action     String // ex. "auth.login_succeeded", "team.member_removed"
  targetType String?  @map("target_type")
  targetId   String?  @map("target_id")
  ipHash     Bytes?   @map("ip_hash")
  metadata   Json     @default("{}")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([merchantId, createdAt])
  @@index([actorType, actorId, createdAt])
  @@index([action, createdAt])
  @@map("audit_logs")
}

// ─── Structure marchand (T-50, §M6) : marchand → boutiques → caisses ─────────

model Store {
  id         String   @id @default(uuid())
  merchantId String   @map("merchant_id")
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name       String
  address    String?
  active     Boolean  @default(true)
  tills      Till[]
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([merchantId, active])
  @@map("stores")
}

// Caisse : point d'encaissement avec son QR unique (§M4) et ses options de
// confirmation Vérif (§M5).
model Till {
  id                String       @id @default(uuid())
  merchantId        String       @map("merchant_id")
  storeId           String       @map("store_id")
  store             Store        @relation(fields: [storeId], references: [id], onDelete: Cascade)
  name              String
  // Code public court, porté par le QR (/c/:code) ; ne révèle aucun identifiant interne.
  publicCode        String       @unique @map("public_code")
  active            Boolean      @default(true)
  // Confirmations Vérif en plus de la notification dans l'application.
  confirmBySms      Boolean      @default(false) @map("confirm_by_sms")
  confirmByWhatsApp Boolean      @default(false) @map("confirm_by_whatsapp")
  members           TillMember[]
  createdAt         DateTime     @default(now()) @map("created_at")
  updatedAt         DateTime     @updatedAt @map("updated_at")

  @@index([merchantId, active])
  @@index([storeId])
  @@map("tills")
}

// Caissier rattaché à une ou plusieurs caisses (§M6).
model TillMember {
  id        String         @id @default(uuid())
  tillId    String         @map("till_id")
  till      Till           @relation(fields: [tillId], references: [id], onDelete: Cascade)
  memberId  String         @map("member_id")
  member    MerchantMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  createdAt DateTime       @default(now()) @map("created_at")

  @@unique([tillId, memberId])
  @@index([memberId])
  @@map("till_members")
}

// ─── Vérif (T-55, §M5) : notifications web push du tableau de bord (PWA) ─────

// Abonnement web push d'un appareil pour un membre. Le point de terminaison
// est fourni par le navigateur ; supprimé si le service push le déclare expiré.
model WebPushSubscription {
  id         String         @id @default(uuid())
  memberId   String         @map("member_id")
  member     MerchantMember @relation(fields: [memberId], references: [id], onDelete: Cascade)
  endpoint   String         @unique
  p256dh     String
  auth       String
  userAgent  String?        @map("user_agent")
  createdAt  DateTime       @default(now()) @map("created_at")
  lastUsedAt DateTime?      @map("last_used_at")

  @@index([memberId])
  @@map("web_push_subscriptions")
}

// ─── Développeurs (T-56, §M10) : journal des requêtes API, conservé 30 jours ───

// Une ligne par requête authentifiée par clé API. Jamais de corps de requête
// ni de réponse (données personnelles) : métadonnées seulement.
model ApiRequestLog {
  id         String   @id @default(uuid())
  merchantId String   @map("merchant_id")
  livemode   Boolean
  apiKeyId   String?  @map("api_key_id")
  method     String
  // Route normalisée (ex. /v1/payments/:id), sans identifiant ni paramètre.
  path       String
  status     Int
  durationMs Int      @map("duration_ms")
  errorCode  String?  @map("error_code")
  requestId  String?  @map("request_id")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([merchantId, livemode, createdAt])
  @@index([createdAt])
  @@map("api_request_logs")
}

// ─── Onboarding marchand (T-59, T-60, §M2) : dossier KYB et KYC du dirigeant ──

// brouillon → soumis → en_revue → approuvé | infos_requises (→ soumis) | refusé
enum KybStatus {
  DRAFT
  SUBMITTED
  IN_REVIEW
  APPROVED
  INFO_REQUIRED
  REJECTED
}

enum KybDocumentType {
  RCCM_EXTRACT
  NIU_CERTIFICATE
  DIRECTOR_ID
}

enum KycCheckStatus {
  PENDING
  APPROVED
  REJECTED
  RETRY
}

// Un dossier par marchand. Seul APPROVED débloque le mode live
// (Merchant.onboardingStatus, tenu à jour par le service KYB).
model KybApplication {
  id                String          @id @default(uuid())
  merchantId        String          @unique @map("merchant_id")
  merchant          Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  status            KybStatus       @default(DRAFT)
  legalName         String?         @map("legal_name")
  legalForm         String?         @map("legal_form")
  rccm              String?
  niu               String?
  address           String?
  sector            String?
  directorFirstName String?         @map("director_first_name")
  directorLastName  String?         @map("director_last_name")
  submittedAt       DateTime?       @map("submitted_at")
  decidedAt         DateTime?       @map("decided_at")
  // Motif de la dernière décision (refus ou compléments demandés), montré au marchand.
  decisionReason    String?         @map("decision_reason")
  createdAt         DateTime        @default(now()) @map("created_at")
  updatedAt         DateTime        @updatedAt @map("updated_at")
  documents         KybDocument[]
  events            KybEvent[]
  kycChecks         KycCheck[]

  @@index([status, submittedAt])
  @@map("kyb_applications")
}

// Pièce jointe chiffrée par l'API (AES-256-GCM) avant stockage ; lue uniquement
// par URL signée et temporaire. Une nouvelle pièce du même type remplace l'ancienne.
model KybDocument {
  id            String          @id @default(uuid())
  applicationId String          @map("application_id")
  application   KybApplication  @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  type          KybDocumentType
  filename      String
  contentType   String          @map("content_type")
  sizeBytes     Int             @map("size_bytes")
  sha256        String
  storageKey    String          @unique @map("storage_key")
  createdAt     DateTime        @default(now()) @map("created_at")

  @@unique([applicationId, type])
  @@map("kyb_documents")
}

// Historique : chaque changement d'état, horodaté, avec son auteur et son motif.
model KybEvent {
  id            String         @id @default(uuid())
  applicationId String         @map("application_id")
  application   KybApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  fromStatus    KybStatus?     @map("from_status")
  toStatus      KybStatus      @map("to_status")
  // user (membre du marchand), staff (équipe AlphaPay) ou system.
  actorType     String         @map("actor_type")
  actorId       String?        @map("actor_id")
  reason        String?
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([applicationId, createdAt])
  @@map("kyb_events")
}

// ─── Exports (T-73, §M6) ─────────────────────────────────────────────────────

enum ExportJobStatus {
  PENDING
  PROCESSING
  DONE
  FAILED
}

enum ExportFormat {
  CSV
  XLSX
}

// Tâche d'export en arrière-plan. Le fichier est stocké dans FileStorage
// et accessible via une URL signée à durée limitée.
model ExportJob {
  id           String          @id @default(uuid())
  merchantId   String          @map("merchant_id")
  merchant     Merchant        @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  requestedBy  String          @map("requested_by")
  member       MerchantMember  @relation("ExportRequester", fields: [requestedBy], references: [id])
  livemode     Boolean         @default(false)
  status       ExportJobStatus @default(PENDING)
  format       ExportFormat    @default(CSV)
  filters      Json            @default("{}")
  rowCount     Int?            @map("row_count")
  fileKey      String?         @map("file_key")
  downloadUrl  String?         @map("download_url")
  urlExpiresAt DateTime?       @map("url_expires_at")
  error        String?
  createdAt    DateTime        @default(now()) @map("created_at")
  updatedAt    DateTime        @updatedAt @map("updated_at")
  completedAt  DateTime?       @map("completed_at")

  @@index([merchantId, createdAt(sort: Desc)])
  @@map("export_jobs")
}

// ─── Rapprochement journalier (T-72, §M6) ────────────────────────────────────

enum ReconciliationDayStatus {
  PENDING
  OK
  DISCREPANCY
}

// Rapprochement journalier par caisse (ou global si till_id null).
// Contrainte UNIQUE partielle gérée en SQL (Prisma ne supporte pas les index partiels).
model ReconciliationDay {
  id               String                    @id @default(uuid())
  merchantId       String                    @map("merchant_id")
  merchant         Merchant                  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  tillId           String?                   @map("till_id")
  entryDate        DateTime                  @map("entry_date") @db.Date
  livemode         Boolean                   @default(false)
  status           ReconciliationDayStatus   @default(PENDING)
  comment          String?
  digitalCount     Int                       @default(0) @map("digital_count")
  digitalAmount    BigInt                    @default(0) @map("digital_amount")
  cashAmount       BigInt                    @default(0) @map("cash_amount")
  currency         String                    @default("XAF")
  statementLines   Int?                      @map("statement_lines")
  statementAmount  BigInt?                   @map("statement_amount")
  statementCsvKey  String?                   @map("statement_csv_key")
  reviewedById     String?                   @map("reviewed_by_id")
  reviewedBy       MerchantMember?           @relation("ReconciliationReviewer", fields: [reviewedById], references: [id])
  reviewedAt       DateTime?                 @map("reviewed_at")
  createdAt        DateTime                  @default(now()) @map("created_at")
  updatedAt        DateTime                  @updatedAt @map("updated_at")

  @@index([merchantId, livemode, entryDate(sort: Desc)])
  @@map("reconciliation_days")
}

// ─── Cash déclaré (T-71, §M6) ────────────────────────────────────────────────

// Cash déclaré manuellement par un caissier en fin de shift.
// Complète le rapprochement journalier (T-72) ; n'affecte pas les encaissements.
model CashEntry {
  id         String         @id @default(uuid())
  merchantId String         @map("merchant_id")
  merchant   Merchant       @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  tillId     String?        @map("till_id")
  memberId   String         @map("member_id")
  member     MerchantMember @relation(fields: [memberId], references: [id])
  amount     BigInt
  currency   String         @default("XAF")
  livemode   Boolean        @default(false)
  note       String?
  entryDate  DateTime       @map("entry_date") @db.Date
  createdAt  DateTime       @default(now()) @map("created_at")
  updatedAt  DateTime       @updatedAt @map("updated_at")

  @@index([merchantId, livemode, entryDate(sort: Desc)])
  @@index([tillId, livemode, entryDate(sort: Desc)])
  @@map("cash_entries")
}

// Vérification d'identité du dirigeant chez le fournisseur KYC (Sumsub ou mock).
model KycCheck {
  id            String         @id @default(uuid())
  applicationId String         @map("application_id")
  application   KybApplication @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  provider      String
  applicantId   String         @map("applicant_id")
  status        KycCheckStatus @default(PENDING)
  // Motifs du fournisseur (refus ou reprise), sans donnée personnelle.
  reasons       String[]       @default([])
  completedAt   DateTime?      @map("completed_at")
  createdAt     DateTime       @default(now()) @map("created_at")
  updatedAt     DateTime       @updatedAt @map("updated_at")

  @@unique([provider, applicantId])
  @@index([applicationId])
  @@map("kyc_checks")
}

// ─── Recouvrement : Clients (T-74, §M7) ──────────────────────────────────────

model Customer {
  id         String    @id @default(uuid())
  merchantId String    @map("merchant_id")
  merchant   Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name       String
  email      String?
  phone      String?
  address    String?
  metadata   Json      @default("{}")
  createdAt  DateTime  @default(now()) @map("created_at")
  updatedAt  DateTime  @updatedAt @map("updated_at")
  invoices   Invoice[]

  @@index([merchantId, createdAt(sort: Desc)])
  @@map("customers")
}

// ─── Compteur de factures par marchand ────────────────────────────────────────

model InvoiceCounter {
  merchantId String   @id @map("merchant_id")
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  lastSeq    Int      @default(0) @map("last_seq")

  @@map("invoice_counters")
}

// ─── Factures (T-74 / T-75, §M7) ─────────────────────────────────────────────

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIAL
  PAID
  VOID
  OVERDUE
}

model Invoice {
  id            String        @id @default(uuid())
  merchantId    String        @map("merchant_id")
  merchant      Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  customerId    String?       @map("customer_id")
  customer      Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  livemode      Boolean       @default(false)
  number        String?
  status        InvoiceStatus @default(DRAFT)
  currency      String        @default("XAF")
  subtotal      BigInt        @default(0)
  taxAmount     BigInt        @default(0) @map("tax_amount")
  total         BigInt        @default(0)
  amountPaid    BigInt        @default(0) @map("amount_paid")
  amountDue     BigInt        @default(0) @map("amount_due")
  issueDate     DateTime      @default(now()) @map("issue_date") @db.Date
  dueDate       DateTime?     @map("due_date") @db.Date
  notes         String?
  footer        String?
  paymentLinkId String?       @map("payment_link_id")
  pdfKey        String?       @map("pdf_key")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  lines         InvoiceLine[]
  installments  InvoiceInstallment[]
  reminders     InvoiceReminder[]
  receipts      Receipt[]

  @@index([merchantId, createdAt(sort: Desc)])
  @@index([customerId, createdAt(sort: Desc)])
  @@index([merchantId, status])
  @@map("invoices")
}

// ─── Lignes de facture ────────────────────────────────────────────────────────

model InvoiceLine {
  id          String   @id @default(uuid())
  invoiceId   String   @map("invoice_id")
  invoice     Invoice  @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  description String
  quantity    Decimal  @db.Decimal(10, 3)
  unitPrice   BigInt   @map("unit_price")
  taxRate     Decimal  @default(0) @map("tax_rate") @db.Decimal(5, 2)
  amount      BigInt
  sortOrder   Int      @default(0) @map("sort_order")
  createdAt   DateTime @default(now()) @map("created_at")

  @@index([invoiceId, sortOrder])
  @@map("invoice_lines")
}

// ─── Versements (T-75) ────────────────────────────────────────────────────────

model InvoiceInstallment {
  id            String            @id @default(uuid())
  invoiceId     String            @map("invoice_id")
  invoice       Invoice           @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  dueDate       DateTime          @map("due_date") @db.Date
  amount        BigInt
  paidAmount    BigInt            @default(0) @map("paid_amount")
  status        String            @default("PENDING")
  paymentLinkId String?           @map("payment_link_id")
  createdAt     DateTime          @default(now()) @map("created_at")
  updatedAt     DateTime          @updatedAt @map("updated_at")
  reminders     InvoiceReminder[]

  @@index([invoiceId, dueDate])
  @@map("invoice_installments")
}

// ─── Relances (T-76) ──────────────────────────────────────────────────────────

enum ReminderStatus {
  PENDING
  SENT
  SKIPPED
  FAILED
}

enum ReminderChannel {
  SMS
  WHATSAPP
  EMAIL
}

model InvoiceReminder {
  id             String              @id @default(uuid())
  invoiceId      String              @map("invoice_id")
  invoice        Invoice             @relation(fields: [invoiceId], references: [id], onDelete: Cascade)
  installmentId  String?             @map("installment_id")
  installment    InvoiceInstallment? @relation(fields: [installmentId], references: [id], onDelete: SetNull)
  channel        ReminderChannel     @default(SMS)
  status         ReminderStatus      @default(PENDING)
  daysOffset     Int                 @map("days_offset")
  scheduledFor   DateTime            @map("scheduled_for")
  sentAt         DateTime?           @map("sent_at")
  error          String?
  createdAt      DateTime            @default(now()) @map("created_at")

  @@index([scheduledFor])
  @@map("invoice_reminders")
}

// ─── Reçus (T-77) ─────────────────────────────────────────────────────────────

model Receipt {
  id            String    @id @default(uuid())
  merchantId    String    @map("merchant_id")
  merchant      Merchant  @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  invoiceId     String?   @map("invoice_id")
  invoice       Invoice?  @relation(fields: [invoiceId], references: [id], onDelete: SetNull)
  transactionId String?   @map("transaction_id")
  number        String
  amount        BigInt
  currency      String    @default("XAF")
  livemode      Boolean   @default(false)
  pdfKey        String?   @map("pdf_key")
  sentAt        DateTime? @map("sent_at")
  createdAt     DateTime  @default(now()) @map("created_at")

  @@index([merchantId, createdAt(sort: Desc)])
  @@map("receipts")
}

// ─── Pack École (T-78/T-79/T-80, §M8) ────────────────────────────────────────

model SchoolYear {
  id         String        @id @default(uuid())
  merchantId String        @map("merchant_id")
  merchant   Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  label      String
  startsOn   DateTime      @map("starts_on") @db.Date
  endsOn     DateTime      @map("ends_on") @db.Date
  isActive   Boolean       @default(false) @map("is_active")
  createdAt  DateTime      @default(now()) @map("created_at")
  updatedAt  DateTime      @updatedAt @map("updated_at")
  classes    SchoolClass[]
  feeGrids   FeeGrid[]

  @@index([merchantId])
  @@map("school_years")
}

model SchoolClass {
  id           String               @id @default(uuid())
  schoolYearId String               @map("school_year_id")
  schoolYear   SchoolYear           @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  merchantId   String               @map("merchant_id")
  merchant     Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  name         String
  capacity     Int?
  createdAt    DateTime             @default(now()) @map("created_at")
  updatedAt    DateTime             @updatedAt @map("updated_at")
  students     Student[]
  feeGrids     FeeGrid[]

  @@index([schoolYearId])
  @@map("school_classes")
}

model Student {
  id             String               @id @default(uuid())
  merchantId     String               @map("merchant_id")
  merchant       Merchant             @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  schoolClassId  String?              @map("school_class_id")
  schoolClass    SchoolClass?         @relation(fields: [schoolClassId], references: [id], onDelete: SetNull)
  firstName      String               @map("first_name")
  lastName       String               @map("last_name")
  dateOfBirth    DateTime?            @map("date_of_birth") @db.Date
  gender         String?
  registrationNo String?              @map("registration_no")
  metadata       Json                 @default("{}")
  createdAt      DateTime             @default(now()) @map("created_at")
  updatedAt      DateTime             @updatedAt @map("updated_at")
  guardians      Guardian[]
  feeSchedules   StudentFeeSchedule[]

  @@index([merchantId])
  @@index([schoolClassId])
  @@map("students")
}

model Guardian {
  id         String   @id @default(uuid())
  merchantId String   @map("merchant_id")
  merchant   Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  studentId  String   @map("student_id")
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  name       String
  phone      String?
  email      String?
  relation   String?
  isPrimary  Boolean  @default(false) @map("is_primary")
  createdAt  DateTime @default(now()) @map("created_at")

  @@index([studentId])
  @@map("guardians")
}

model FeeGrid {
  id            String        @id @default(uuid())
  merchantId    String        @map("merchant_id")
  merchant      Merchant      @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  schoolYearId  String        @map("school_year_id")
  schoolYear    SchoolYear    @relation(fields: [schoolYearId], references: [id], onDelete: Cascade)
  schoolClassId String?       @map("school_class_id")
  schoolClass   SchoolClass?  @relation(fields: [schoolClassId], references: [id], onDelete: SetNull)
  label         String
  currency      String        @default("XAF")
  createdAt     DateTime      @default(now()) @map("created_at")
  updatedAt     DateTime      @updatedAt @map("updated_at")
  lines         FeeGridLine[]

  @@index([schoolYearId])
  @@index([schoolClassId])
  @@map("fee_grids")
}

model FeeGridLine {
  id          String               @id @default(uuid())
  feeGridId   String               @map("fee_grid_id")
  feeGrid     FeeGrid              @relation(fields: [feeGridId], references: [id], onDelete: Cascade)
  label       String
  amount      BigInt
  dueDate     DateTime?            @map("due_date") @db.Date
  sortOrder   Int                  @default(0) @map("sort_order")
  schedules   StudentFeeSchedule[]

  @@index([feeGridId, sortOrder])
  @@map("fee_grid_lines")
}

model StudentFeeSchedule {
  id             String      @id @default(uuid())
  merchantId     String      @map("merchant_id")
  merchant       Merchant    @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  studentId      String      @map("student_id")
  student        Student     @relation(fields: [studentId], references: [id], onDelete: Cascade)
  feeGridLineId  String      @map("fee_grid_line_id")
  feeGridLine    FeeGridLine @relation(fields: [feeGridLineId], references: [id])
  invoiceId      String?     @map("invoice_id")
  amount         BigInt
  amountPaid     BigInt      @default(0) @map("amount_paid")
  dueDate        DateTime?   @map("due_date") @db.Date
  status         String      @default("PENDING")
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  @@index([studentId])
  @@index([merchantId, status])
  @@map("student_fee_schedules")
}
