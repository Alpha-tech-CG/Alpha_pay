generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum TransactionStatus {
  PENDING
  SUCCESSFUL
  FAILED
  REJECTED
}

enum Operator {
  MTN
  AIRTEL
  CINETPAY
  WALLET
  BANK
}

enum OutboxStatus {
  PENDING
  PROCESSING
  SENT
  DEAD
}

enum AccountType {
  ASSET
  LIABILITY
  REVENUE
  EXPENSE
  EQUITY
}

enum EntryDirection {
  DEBIT
  CREDIT
}

enum WebhookInboundStatus {
  RECEIVED
  PROCESSED
  DUPLICATE
}

enum ApiKeyMode {
  TEST
  LIVE
}

enum WebhookEndpointStatus {
  ACTIVE
  DISABLED
}

enum WebhookDeliveryStatus {
  PENDING
  SUCCESS
  FAILED
}

enum ReconciliationDiscrepancyType {
  LEDGER_NOT_IN_STATEMENT
  STATEMENT_NOT_IN_LEDGER
  AMOUNT_MISMATCH
  DUPLICATE
}

enum NotificationChannel {
  SMS
  EMAIL
  WEBHOOK
}

enum NotificationStatus {
  SENT
  DELIVERED
  FAILED
  SKIPPED
}

enum SettlementFrequency {
  DAILY
  T1
  T2
  WEEKLY
}

enum SettlementStatus {
  PENDING_VALIDATION
  INITIATED
  SENT
  CONFIRMED
  FAILED
}

enum SettlementPayoutMethod {
  BANK
  MOMO
}

enum KycStatus {
  NOT_STARTED
  SUBMITTED
  IN_REVIEW
  APPROVED
  REJECTED
  NEEDS_MORE
}

enum KycDocumentType {
  ID_FRONT
  ID_BACK
  RCCM
  NIU
  STATUTES
  PROOF_OF_ADDRESS
}

enum OnboardingStatus {
  PENDING
  APPROVED
  REJECTED
}

enum MerchantType {
  MERCHANT
  DEVELOPER
}

enum UserRole {
  CLIENT
  MERCHANT
  MERCHANT_CASHIER
  ADMIN_STAFF
}

enum WalletStatus {
  PENDING_VERIFICATION
  ACTIVE
  SUSPENDED
  CLOSED
}

enum WalletTxType {
  CASH_IN
  PAY
  CASH_OUT
  P2P_SEND
  P2P_RECEIVE
  REFUND
}

// Niveaux KYC e-money (ALP-174). N0 = numéro vérifié (OTP) seulement ;
// N1 = pièce d'identité vérifiée ; N2 = vérification renforcée.
enum WalletKycLevel {
  N0
  N1
  N2
}

// Pièces d'identité uploadées par le client pour passer N0 → N1 (ALP-177).
enum WalletKycDocType {
  ID_FRONT
  ID_BACK
  SELFIE
}

enum WalletKycDocStatus {
  PENDING
  APPROVED
  REJECTED
}

// Portefeuille électronique du client final (closed-loop wallet).
model Wallet {
  id                String         @id @default(uuid())
  phone             String         @unique
  pinHash           String         @map("pin_hash")
  balanceCents      BigInt         @default(0) @map("balance_cents")
  currency          String         @default("XAF")
  role              UserRole       @default(CLIENT)
  status            WalletStatus   @default(ACTIVE)
  kycLevel          WalletKycLevel @default(N0) @map("kyc_level")
  fullName          String?        @map("full_name")
  pushToken         String?        @map("push_token")
  // Rattachement d'un caissier (MERCHANT_CASHIER) au marchand pour lequel il encaisse.
  merchantId        String?        @map("merchant_id")
  merchant          Merchant?      @relation(fields: [merchantId], references: [id])
  // OTP d'inscription (ALP-171) : preuve de possession du numéro.
  otpHash           String?        @map("otp_hash")
  otpExpiresAt      DateTime?      @map("otp_expires_at")
  otpAttempts       Int            @default(0) @map("otp_attempts")
  // Verrouillage progressif anti brute-force PIN (ALP-173).
  failedPinAttempts Int            @default(0) @map("failed_pin_attempts")
  lockedUntil       DateTime?      @map("locked_until")
  createdAt         DateTime       @default(now()) @map("created_at")
  updatedAt         DateTime       @updatedAt @map("updated_at")

  sentTxs      WalletTransaction[] @relation("SenderWallet")
  receivedTxs  WalletTransaction[] @relation("ReceiverWallet")
  kycDocuments WalletKycDocument[]

  @@index([phone])
  @@index([merchantId])
  @@map("wallets")
}

// Transaction sur portefeuille client (ledger simplifié en partie simple).
model WalletTransaction {
  id             String            @id @default(uuid())
  walletId       String            @map("wallet_id")
  wallet         Wallet            @relation("SenderWallet", fields: [walletId], references: [id])
  type           WalletTxType
  amountCents    BigInt            @map("amount_cents")
  balanceBefore  BigInt            @map("balance_before")
  balanceAfter   BigInt            @map("balance_after")
  status         TransactionStatus @default(PENDING)
  description    String?
  operatorRef    String?           @map("operator_ref") // référence opérateur (MTN/Airtel)
  merchantId     String?           @map("merchant_id") // si PAY vers un marchand
  peerWalletId   String?           @map("peer_wallet_id") // si P2P
  peerWallet     Wallet?           @relation("ReceiverWallet", fields: [peerWalletId], references: [id])
  idempotencyKey String?           @map("idempotency_key") // rejeu client (double-tap, retry réseau)
  qrNonce        String?           @unique @map("qr_nonce") // usage unique d'un QR signé (anti-rejeu)
  metadata       Json?
  createdAt      DateTime          @default(now()) @map("created_at")

  @@unique([walletId, idempotencyKey])
  @@index([walletId, createdAt])
  @@index([merchantId])
  @@index([status])
  @@map("wallet_transactions")
}

// Plafonds e-money par niveau KYC (ALP-174). Table éditable (endpoint interne)
// pour ajuster les seuils sans redéploiement, en fonction des exigences BEAC /
// de la banque partenaire. Montants en centimes (×100), devise wallet (XAF).
model WalletLimit {
  level           WalletKycLevel @id
  maxBalanceCents BigInt         @map("max_balance_cents") // solde maximum autorisé
  perTxCents      BigInt         @map("per_tx_cents") // montant max par opération sortante
  dailyCents      BigInt         @map("daily_cents") // volume sortant / 24 h glissantes
  monthlyCents    BigInt         @map("monthly_cents") // volume sortant / 30 j glissants
  updatedAt       DateTime       @updatedAt @map("updated_at")

  @@map("wallet_limits")
}

// Pièce d'identité soumise par un client wallet lors de l'inscription (KYC N1).
// Démo : l'image est stockée encodée en base (base64) — pas de dépendance S3.
// En prod, remplacer `dataBase64` par une clé d'objet chiffré (bucket KYC).
model WalletKycDocument {
  id           String             @id @default(uuid())
  walletId     String             @map("wallet_id")
  wallet       Wallet             @relation(fields: [walletId], references: [id])
  type         WalletKycDocType
  mimeType     String             @map("mime_type")
  storageKey   String             @map("storage_key") // clé S3 (KYC_DOCUMENTS_BUCKET)
  status       WalletKycDocStatus @default(PENDING)
  reviewedBy   String?            @map("reviewed_by") // officer (e-mail)
  reviewReason String?            @map("review_reason")
  reviewedAt   DateTime?          @map("reviewed_at")
  createdAt    DateTime           @default(now()) @map("created_at")

  @@index([walletId])
  @@index([status])
  @@map("wallet_kyc_documents")
}

model Merchant {
  id               String                @id @default(uuid())
  name             String
  emailEncrypted   Bytes                 @map("email_encrypted")
  emailHash        Bytes                 @unique @map("email_hash")
  phone            String?
  companyName      String?               @map("company_name")
  country          String?
  website          String?
  useCase          String?               @map("use_case")
  idDocumentKey    String?               @map("id_document_key")
  merchantType     MerchantType          @default(MERCHANT) @map("merchant_type")
  onboardingStatus OnboardingStatus      @default(PENDING) @map("onboarding_status")
  rejectionReason  String?               @map("rejection_reason")
  feeProfileId     String?               @map("fee_profile_id") // commission techno appliquée (orchestration)
  isActive         Boolean               @default(false) @map("is_active")
  clerkUserId      String?               @unique @map("clerk_user_id")
  ownerUserId      String?               @map("owner_user_id")
  createdAt        DateTime              @default(now()) @map("created_at")
  updatedAt        DateTime              @updatedAt @map("updated_at")
  transactions     Transaction[]
  paymentLinks     PaymentLink[]
  apiKeys          ApiKey[]
  webhookEndpoints WebhookEndpoint[]
  cashierWallets   Wallet[]
  owner            AppUser?              @relation("MerchantOwner", fields: [ownerUserId], references: [id])
  members          MerchantMember[]
  invitations      MerchantInvitation[]
  memberEvents     MerchantMemberEvent[]
  feeProfile       FeeProfile?           @relation(fields: [feeProfileId], references: [id])

  @@index([onboardingStatus])
  @@index([feeProfileId])
  @@map("merchants")
}

// Clés API marchand (ALP-136). Secret haché (scrypt) — affiché une seule fois
// à la création. Lookup par prefix unique, puis vérification du secret.
model ApiKey {
  id           String     @id @default(uuid())
  merchantId   String     @map("merchant_id")
  merchant     Merchant   @relation(fields: [merchantId], references: [id])
  name         String
  mode         ApiKeyMode @default(TEST)
  prefix       String     @unique
  hashedSecret String     @map("hashed_secret")
  scopes       String[]   @default([])
  ipAllowlist  String[]   @default([]) @map("ip_allowlist")
  lastUsedAt   DateTime?  @map("last_used_at")
  revokedAt    DateTime?  @map("revoked_at")
  createdAt    DateTime   @default(now()) @map("created_at")

  @@index([merchantId])
  @@map("api_keys")
}

// Endpoints webhook sortants déclarés par le marchand (ALP-132 / ALP-136).
model WebhookEndpoint {
  id         String                @id @default(uuid())
  merchantId String                @map("merchant_id")
  merchant   Merchant              @relation(fields: [merchantId], references: [id])
  url        String
  events     String[]              @default([])
  secret     String // secret de signature HMAC propre à l'endpoint
  status     WebhookEndpointStatus @default(ACTIVE)
  createdAt  DateTime              @default(now()) @map("created_at")
  deliveries WebhookDelivery[]

  @@index([merchantId])
  @@map("webhook_endpoints")
}

// Tentatives de livraison webhook sortantes (ALP-132). Payload + réponse stockés
// pour debug ; retry programmé via nextRetryAt (30s, 2m, 10m, 1h, 6h, 24h).
model WebhookDelivery {
  id             String                @id @default(uuid())
  endpointId     String                @map("endpoint_id")
  endpoint       WebhookEndpoint       @relation(fields: [endpointId], references: [id])
  event          String
  webhookId      String                @unique @map("webhook_id")
  payload        Json
  status         WebhookDeliveryStatus @default(PENDING)
  attempts       Int                   @default(0)
  responseStatus Int?                  @map("response_status")
  responseBody   String?               @map("response_body")
  lastError      String?               @map("last_error")
  nextRetryAt    DateTime              @default(now()) @map("next_retry_at")
  createdAt      DateTime              @default(now()) @map("created_at")

  @@index([status, nextRetryAt])
  @@index([endpointId])
  @@map("webhook_deliveries")
}

model Transaction {
  id             String             @id @default(uuid())
  merchantId     String             @map("merchant_id")
  merchant       Merchant           @relation(fields: [merchantId], references: [id])
  mtnReferenceId String?            @map("mtn_reference_id")
  operator       Operator           @default(MTN)
  externalId     String             @map("external_id")
  // Montant en centimes (BIGINT) — entier exact, zéro arrondi flottant (ALP-168).
  amount         BigInt
  currency       String             @default("XAF")
  // PII chiffrée (ALP-164) : numéro jamais en clair en base.
  payerPhoneEnc  Bytes?             @map("payer_phone_enc")
  payerPhoneHash Bytes?             @map("payer_phone_hash")
  payerPhoneMask String?            @map("payer_phone_mask")
  status         TransactionStatus  @default(PENDING)
  payerMessage   String?            @map("payer_message")
  failureReason  String?            @map("failure_reason")
  retryCount     Int                @default(0) @map("retry_count")
  version        Int                @default(0)
  // Orchestration (migration 17) : partenaire choisi + traçabilité du routage
  // et commission techno appliquée. Scalaires de suivi (pas de relation).
  partnerId      String?            @map("partner_id")
  routingRuleId  String?            @map("routing_rule_id")
  routingReason  String?            @map("routing_reason")
  feeCents       BigInt?            @map("fee_cents")
  createdAt      DateTime           @default(now()) @map("created_at")
  updatedAt      DateTime           @updatedAt @map("updated_at")
  webhookLogs    WebhookLog[]
  outboxEvents   OutboxEvent[]
  audits         TransactionAudit[]

  @@unique([merchantId, externalId])
  @@index([status])
  @@index([merchantId])
  @@index([externalId])
  @@index([mtnReferenceId])
  @@index([payerPhoneHash])
  @@index([partnerId])
  @@map("transactions")
}

// Journal d'audit des transitions de statut de transaction (ALP-167).
model TransactionAudit {
  id            String      @id @default(uuid())
  transactionId String      @map("transaction_id")
  transaction   Transaction @relation(fields: [transactionId], references: [id])
  fromStatus    String      @map("from_status")
  toStatus      String      @map("to_status")
  reason        String?
  createdAt     DateTime    @default(now()) @map("created_at")

  @@index([transactionId])
  @@map("transaction_audits")
}

model OutboxEvent {
  id            String       @id @default(uuid())
  transactionId String       @map("transaction_id")
  transaction   Transaction  @relation(fields: [transactionId], references: [id])
  type          String
  payload       Json
  status        OutboxStatus @default(PENDING)
  attempts      Int          @default(0)
  maxAttempts   Int          @default(5) @map("max_attempts")
  lastError     String?      @map("last_error")
  nextAttemptAt DateTime     @default(now()) @map("next_attempt_at")
  createdAt     DateTime     @default(now()) @map("created_at")
  updatedAt     DateTime     @updatedAt @map("updated_at")

  @@index([status, nextAttemptAt])
  @@map("outbox_events")
}

model WebhookLog {
  id             String       @id @default(uuid())
  transactionId  String?      @map("transaction_id")
  transaction    Transaction? @relation(fields: [transactionId], references: [id])
  mtnReferenceId String?      @map("mtn_reference_id")
  event          String
  payload        Json
  processedAt    DateTime     @default(now()) @map("processed_at")

  @@map("webhooks_log")
}

model PaymentLink {
  id          String    @id @default(uuid())
  merchantId  String    @map("merchant_id")
  merchant    Merchant  @relation(fields: [merchantId], references: [id])
  amount      BigInt // centimes (ALP-168)
  currency    String    @default("XAF")
  description String
  code        String?   @unique @map("ussd_code") // code court composable en USSD (téléphones à touches)
  expiresAt   DateTime? @map("expires_at")
  usedAt      DateTime? @map("used_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@map("payment_links")
}

// Déduplication des webhooks entrants (ALP-157 + ALP-158).
// Garantit qu'un même event operator ne déclenche le traitement qu'une seule fois.
model WebhookInboundEvent {
  id              String               @id @default(uuid())
  operator        Operator
  providerEventId String               @map("provider_event_id")
  signatureHex    String               @map("signature_hex")
  timestampEpoch  Int                  @map("timestamp_epoch")
  rawPayload      Json                 @map("raw_payload")
  status          WebhookInboundStatus @default(RECEIVED)
  createdAt       DateTime             @default(now()) @map("created_at")

  @@unique([operator, providerEventId])
  @@map("webhook_inbound_events")
}

// Idempotence sur POST /payments (ALP-156).
// Mémorise la réponse 24h pour rejouer à l'identique si le marchand retente.
model IdempotencyRecord {
  id             String    @id @default(uuid())
  merchantId     String    @map("merchant_id")
  idempotencyKey String    @map("idempotency_key")
  endpoint       String
  requestHash    Bytes     @map("request_hash")
  lockedUntil    DateTime? @map("locked_until")
  responseStatus Int?      @map("response_status")
  responseBody   Json?     @map("response_body")
  createdAt      DateTime  @default(now()) @map("created_at")
  expiresAt      DateTime  @map("expires_at")

  @@unique([merchantId, idempotencyKey, endpoint])
  @@index([expiresAt])
  @@map("idempotency_records")
}

// Liste d'attente du site marketing (ALP-133).
model WaitlistEntry {
  id        String   @id @default(uuid())
  email     String   @unique
  locale    String   @default("fr")
  createdAt DateTime @default(now()) @map("created_at")

  @@map("waitlist_entries")
}

// Messages du formulaire de contact (ALP-133).
model ContactMessage {
  id        String   @id @default(uuid())
  name      String
  email     String
  message   String
  createdAt DateTime @default(now()) @map("created_at")

  @@map("contact_messages")
}

// Pipeline KYC marchand (ALP-142). Conservation 10 ans (réglementaire).
model KycCase {
  id              String        @id @default(uuid())
  merchantId      String        @unique @map("merchant_id")
  status          KycStatus     @default(NOT_STARTED)
  smileScore      Int?          @map("smile_score")
  smileJobId      String?       @unique @map("smile_job_id")
  screeningHit    Boolean       @default(false) @map("screening_hit")
  screeningLists  String[]      @default([]) @map("screening_lists")
  lastScreenedAt  DateTime?     @map("last_screened_at")
  decision        String?
  decidedBy       String?       @map("decided_by")
  decidedAt       DateTime?     @map("decided_at")
  rejectionReason String?       @map("rejection_reason")
  reKycDueAt      DateTime?     @map("re_kyc_due_at")
  reKycStartedAt  DateTime?     @map("re_kyc_started_at")
  createdAt       DateTime      @default(now()) @map("created_at")
  updatedAt       DateTime      @updatedAt @map("updated_at")
  documents       KycDocument[]
  events          KycEvent[]

  @@map("kyc_cases")
}

model KycDocument {
  id         String          @id @default(uuid())
  caseId     String          @map("case_id")
  kycCase    KycCase         @relation(fields: [caseId], references: [id])
  type       KycDocumentType
  // Référence S3 (bucket chiffré, jamais public). L'upload se fait via URL pré-signée.
  s3Key      String          @map("s3_key")
  uploadedAt DateTime        @default(now()) @map("uploaded_at")

  @@unique([caseId, type])
  @@map("kyc_documents")
}

model KycEvent {
  id        String   @id @default(uuid())
  caseId    String   @map("case_id")
  kycCase   KycCase  @relation(fields: [caseId], references: [id])
  action    String
  actor     String
  details   String?
  createdAt DateTime @default(now()) @map("created_at")

  @@index([caseId])
  @@map("kyc_events")
}

// Reversement aux marchands : configuration + batches (ALP-141).
model MerchantSettlementConfig {
  id                         String                 @id @default(uuid())
  merchantId                 String                 @unique @map("merchant_id")
  frequency                  SettlementFrequency    @default(T1)
  minAmountCents             BigInt                 @default(0) @map("min_amount_cents")
  commissionBps              Int                    @default(150) @map("commission_bps") // 1.5%
  dayOfWeek                  Int?                   @map("day_of_week") // 1=lundi (fréquence WEEKLY)
  enabled                    Boolean                @default(true)
  payoutMethod               SettlementPayoutMethod @default(MOMO) @map("payout_method")
  payoutProvider             String?                @map("payout_provider")
  payoutDestinationEncrypted Bytes?                 @map("payout_destination_encrypted")
  // Devise de reversement souhaitée par le marchand (ALP-151). Si différente de
  // la devise encaissée, le net est converti au moment du settlement.
  settlementCurrency         String?                @map("settlement_currency")
  createdAt                  DateTime               @default(now()) @map("created_at")

  @@map("merchant_settlement_configs")
}

model SettlementBatch {
  id                       String            @id @default(uuid())
  batchNumber              String            @unique @map("batch_number")
  merchantId               String            @map("merchant_id")
  periodStart              DateTime          @map("period_start")
  periodEnd                DateTime          @map("period_end")
  currency                 String            @default("XAF")
  grossCents               BigInt            @map("gross_cents")
  commissionCents          BigInt            @map("commission_cents")
  holdsCents               BigInt            @default(0) @map("holds_cents")
  netCents                 BigInt            @map("net_cents")
  // FX (ALP-151) : si la devise de reversement diffère de la devise encaissée,
  // le net converti et le taux utilisé sont conservés pour le décaissement.
  settlementCurrency       String?           @map("settlement_currency")
  settledNetCents          BigInt?           @map("settled_net_cents")
  fxRate                   Decimal?          @map("fx_rate") @db.Decimal(20, 10)
  status                   SettlementStatus  @default(INITIATED)
  requiresDoubleValidation Boolean           @default(false) @map("requires_double_validation")
  validatedBy              String[]          @default([]) @map("validated_by")
  version                  Int               @default(0)
  sentAt                   DateTime?         @map("sent_at")
  confirmedAt              DateTime?         @map("confirmed_at")
  failedAt                 DateTime?         @map("failed_at")
  failureReason            String?           @map("failure_reason")
  payoutProvider           String?           @map("payout_provider")
  externalReference        String?           @map("external_reference")
  receiptPdfKey            String?           @map("receipt_pdf_key")
  createdAt                DateTime          @default(now()) @map("created_at")
  audits                   SettlementAudit[]

  @@index([merchantId, status])
  // Index unique PARTIEL (merchant_id, period_start, period_end) WHERE status <> 'FAILED'
  // — défense en profondeur anti double-reversement. Non exprimable en Prisma
  // (index partiel) : défini en SQL brut dans la migration 16_settlement_period_unique.
  @@map("settlement_batches")
}

model SettlementAudit {
  id        String          @id @default(uuid())
  batchId   String          @map("batch_id")
  batch     SettlementBatch @relation(fields: [batchId], references: [id])
  action    String
  actor     String
  details   String?
  createdAt DateTime        @default(now()) @map("created_at")

  @@index([batchId])
  @@map("settlement_audits")
}

// Notifications multi-canal (ALP-143).
model NotificationLog {
  id                String              @id @default(uuid())
  channel           NotificationChannel
  recipient         String
  template          String
  templateVersion   String              @map("template_version")
  category          String
  status            NotificationStatus
  provider          String?
  providerMessageId String?             @map("provider_message_id")
  attempts          Int                 @default(1)
  error             String?
  deliveredAt       DateTime?           @map("delivered_at")
  createdAt         DateTime            @default(now()) @map("created_at")
  updatedAt         DateTime            @updatedAt @map("updated_at")

  @@index([channel, status])
  @@index([provider, providerMessageId])
  @@map("notification_logs")
}

// Préférences marchand : opt-out par (catégorie, canal). Absence = opt-in.
model NotificationPreference {
  id         String              @id @default(uuid())
  merchantId String              @map("merchant_id")
  category   String
  channel    NotificationChannel
  optedOut   Boolean             @default(false) @map("opted_out")

  @@unique([merchantId, category, channel])
  @@map("notification_preferences")
}

// Réconciliation : un run rapproche un relevé opérateur du ledger interne (ALP-140).
model ReconciliationRun {
  id               String                      @id @default(uuid())
  operator         Operator
  statementDate    DateTime                    @map("statement_date")
  statementLines   Int                         @map("statement_lines")
  matchedCount     Int                         @map("matched_count")
  discrepancyCount Int                         @map("discrepancy_count")
  totalStatement   BigInt                      @map("total_statement") // centimes
  totalLedger      BigInt                      @map("total_ledger") // centimes
  maxDiscrepancy   BigInt                      @map("max_discrepancy") // centimes
  alert            Boolean                     @default(false) // true si écart > seuil P1
  reportJson       Json                        @map("report_json")
  reportJsonKey    String?                     @map("report_json_key")
  reportPdfKey     String?                     @map("report_pdf_key")
  archivedAt       DateTime?                   @map("archived_at")
  createdAt        DateTime                    @default(now()) @map("created_at")
  discrepancies    ReconciliationDiscrepancy[]

  @@index([operator, statementDate])
  @@map("reconciliation_runs")
}

model ReconciliationDiscrepancy {
  id              String                        @id @default(uuid())
  runId           String                        @map("run_id")
  run             ReconciliationRun             @relation(fields: [runId], references: [id])
  type            ReconciliationDiscrepancyType
  reference       String
  ledgerAmount    BigInt?                       @map("ledger_amount") // centimes
  statementAmount BigInt?                       @map("statement_amount") // centimes
  details         String?

  @@index([runId])
  @@map("reconciliation_discrepancies")
}

// Réconciliation du float wallet (ALP-175). Vérifie l'intégrité interne du
// sous-système wallet : Σ soldes == Σ transactions signées, et l'exposition
// float sur les comptes de collecte opérateurs.
model WalletReconciliationRun {
  id                      String   @id @default(uuid())
  runDate                 DateTime @map("run_date")
  walletCount             Int      @map("wallet_count")
  totalBalanceCents       BigInt   @map("total_balance_cents") // Σ soldes courants
  expectedBalanceCents    BigInt   @map("expected_balance_cents") // Σ txs SUCCESSFUL signées
  driftCents              BigInt   @map("drift_cents") // total − expected (doit être 0)
  cashInCents             BigInt   @map("cash_in_cents")
  cashOutCents            BigInt   @map("cash_out_cents")
  payCents                BigInt   @map("pay_cents")
  floatExposureCents      BigInt   @map("float_exposure_cents") // cash-in − cash-out
  inconsistentWalletCount Int      @default(0) @map("inconsistent_wallet_count")
  alert                   Boolean  @default(false)
  reportJson              Json     @map("report_json")
  createdAt               DateTime @default(now()) @map("created_at")

  @@index([runDate])
  @@map("wallet_reconciliation_runs")
}

// Grand livre comptable en partie double. Source de vérité financière :
// immutable et auditable via chaînage cryptographique (cf. LedgerService).
model LedgerAccount {
  id         String                  @id @default(uuid())
  merchantId String?                 @map("merchant_id")
  name       String
  type       AccountType
  createdAt  DateTime                @default(now()) @map("created_at")
  entries    JournalEntry[]
  snapshots  LedgerBalanceSnapshot[]

  @@unique([merchantId, name])
  @@map("ledger_accounts")
}

// Lignes d'écriture immuables. Aucune opération UPDATE/DELETE n'est exposée
// par LedgerService sur ce modèle — toute correction se fait par contre-écriture.
model JournalEntry {
  id            String         @id @default(uuid())
  sequence      BigInt         @default(autoincrement())
  transactionId String         @map("transaction_id")
  accountId     String         @map("account_id")
  account       LedgerAccount  @relation(fields: [accountId], references: [id])
  direction     EntryDirection
  amount        BigInt
  currency      String
  description   String?
  prevHash      String         @map("prev_hash")
  hash          String
  createdAt     DateTime       @default(now()) @map("created_at")

  @@index([accountId])
  @@index([transactionId])
  @@index([sequence])
  @@map("journal_entries")
}

model LedgerBalanceSnapshot {
  id           String        @id @default(uuid())
  accountId    String        @map("account_id")
  account      LedgerAccount @relation(fields: [accountId], references: [id])
  balance      BigInt
  asOfSequence BigInt        @map("as_of_sequence")
  createdAt    DateTime      @default(now()) @map("created_at")

  @@index([accountId, asOfSequence])
  @@map("ledger_balance_snapshots")
}

// Tokens push Expo pour notifications marchands (ALP-150).
model PushToken {
  id         String   @id @default(uuid())
  merchantId String   @map("merchant_id")
  token      String
  platform   String   @default("expo")
  createdAt  DateTime @default(now()) @map("created_at")

  @@unique([merchantId, token])
  @@index([merchantId])
  @@map("push_tokens")
}

// Taux de change (ALP-151) : 1 unité de `base` = `rate` unités de `quote`.
// Alimentés en interne (configurable / seed) — pas d'API externe requise.
model CurrencyRate {
  id        String   @id @default(uuid())
  base      String
  quote     String
  rate      Decimal  @db.Decimal(20, 10)
  source    String   @default("manual")
  updatedAt DateTime @updatedAt @map("updated_at")
  createdAt DateTime @default(now()) @map("created_at")

  @@unique([base, quote])
  @@map("currency_rates")
}

// ─────────────────────────────────────────────────────────────────────────
// Équipe marchand / multi-tenant (ALP-team). Un utilisateur peut appartenir à
// plusieurs marchands avec un rôle par marchand. Identité locale = AppUser
// (miroir Clerk, alimenté par le webhook Clerk). Voir migrations 13/14.
// ─────────────────────────────────────────────────────────────────────────

enum MerchantMemberRole {
  OWNER
  ADMIN
  MANAGER
  MEMBER
  VIEWER
}

enum MerchantMemberStatus {
  INVITED
  ACTIVE
  SUSPENDED
  REMOVED
}

enum MerchantMemberEventType {
  INVITATION_SENT
  INVITATION_ACCEPTED
  INVITATION_REVOKED
  ROLE_CHANGED
  MEMBER_SUSPENDED
  MEMBER_REACTIVATED
  MEMBER_REMOVED
  OWNERSHIP_TRANSFERRED
}

/// Utilisateur local (miroir Clerk). PII chiffrée comme Merchant.
model AppUser {
  id             String   @id @default(uuid())
  clerkUserId    String?  @unique @map("clerk_user_id")
  emailEncrypted Bytes    @map("email_encrypted")
  emailHash      Bytes    @unique @map("email_hash")
  fullName       String?  @map("full_name")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  memberships     MerchantMember[]
  invitationsSent MerchantInvitation[]  @relation("InvitedBy")
  memberEvents    MerchantMemberEvent[] @relation("Actor")
  ownedMerchants  Merchant[]            @relation("MerchantOwner")

  @@map("app_users")
}

/// Appartenance d'un utilisateur à un marchand (source de vérité).
model MerchantMember {
  id          String               @id @default(uuid())
  merchantId  String               @map("merchant_id")
  userId      String               @map("user_id")
  role        MerchantMemberRole   @default(MEMBER)
  status      MerchantMemberStatus @default(INVITED)
  invitedAt   DateTime?            @map("invited_at")
  joinedAt    DateTime?            @map("joined_at")
  suspendedAt DateTime?            @map("suspended_at")
  removedAt   DateTime?            @map("removed_at")
  createdAt   DateTime             @default(now()) @map("created_at")
  updatedAt   DateTime             @updatedAt @map("updated_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  user     AppUser  @relation(fields: [userId], references: [id])

  // NB : un index unique PARTIEL « un seul OWNER actif par marchand » est créé
  // dans la migration SQL (Prisma ne gère pas les index partiels).
  @@unique([merchantId, userId])
  @@index([merchantId, status])
  @@index([userId, status])
  @@map("merchant_members")
}

/// Invitation par e-mail. Token JAMAIS stocké en clair (SHA-256).
model MerchantInvitation {
  id             String             @id @default(uuid())
  merchantId     String             @map("merchant_id")
  emailHash      Bytes              @map("email_hash")
  emailEncrypted Bytes              @map("email_encrypted")
  role           MerchantMemberRole @default(MEMBER)
  tokenHash      String             @unique @map("token_hash")
  invitedById    String             @map("invited_by")
  expiresAt      DateTime           @map("expires_at")
  acceptedAt     DateTime?          @map("accepted_at")
  revokedAt      DateTime?          @map("revoked_at")
  createdAt      DateTime           @default(now()) @map("created_at")

  merchant  Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  invitedBy AppUser  @relation("InvitedBy", fields: [invitedById], references: [id])

  // Index partiel « une seule invitation en attente par (marchand,email) » → migration SQL.
  @@index([merchantId])
  @@map("merchant_invitations")
}

/// Journal d'audit append-only des actions d'équipe.
model MerchantMemberEvent {
  id          String                  @id @default(uuid())
  merchantId  String                  @map("merchant_id")
  memberId    String?                 @map("member_id")
  actorUserId String?                 @map("actor_user_id")
  eventType   MerchantMemberEventType @map("event_type")
  metadata    Json                    @default("{}")
  createdAt   DateTime                @default(now()) @map("created_at")

  merchant Merchant @relation(fields: [merchantId], references: [id], onDelete: Cascade)
  actor    AppUser? @relation("Actor", fields: [actorUserId], references: [id])

  @@index([merchantId, createdAt])
  @@map("merchant_member_events")
}

// ─────────────────────────────────────────────────────────────────────────────
// ORCHESTRATION (migration 17) — modèle « fournisseur de technologie de paiement »
// AlphaPay orchestre entre partenaires (banques, MNO, réseaux carte) SANS jamais
// détenir les fonds. Les entités ci-dessous sont des règles/instructions/miroirs,
// aucun compte ne « détient » de la valeur.
// ─────────────────────────────────────────────────────────────────────────────

enum PartnerType {
  BANK
  MOBILE_OPERATOR
  CARD_SCHEME
  CARD_ISSUER // émetteur/BIN sponsor (l'émetteur LÉGAL des cartes, pas nous)
  PSP
}

enum PartnerStatus {
  TEST
  ACTIVE
  INACTIVE
}

enum PaymentMethodType {
  CARD
  MOBILE_MONEY
  BANK_TRANSFER
}

// Partenaire financier. Un partenaire = un adapter côté code (port/adapter).
model Partner {
  id             String              @id @default(uuid())
  code           String              @unique // ex "MTN_CG", "SPONSOR_BANK", "VISA"
  name           String
  type           PartnerType
  country        String // ISO-3166 alpha-2
  currency       String // devise principale
  status         PartnerStatus       @default(TEST)
  sandboxBaseUrl String?             @map("sandbox_base_url")
  prodBaseUrl    String?             @map("prod_base_url")
  timeoutMs      Int                 @default(15000) @map("timeout_ms")
  maxRetries     Int                 @default(2) @map("max_retries")
  credentials    PartnerCredential[]
  routingRules   RoutingRule[]
  createdAt      DateTime            @default(now()) @map("created_at")
  updatedAt      DateTime            @updatedAt @map("updated_at")

  @@map("partners")
}

// Credentials partenaires — chiffrés au repos (AES-256-GCM, common/security/pii-crypto).
model PartnerCredential {
  id             String   @id @default(uuid())
  partnerId      String   @map("partner_id")
  partner        Partner  @relation(fields: [partnerId], references: [id], onDelete: Cascade)
  environment    String // "sandbox" | "production"
  keyName        String   @map("key_name")
  valueEncrypted Bytes    @map("value_encrypted")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  @@unique([partnerId, environment, keyName])
  @@map("partner_credentials")
}

// Règle de routage : conditions à NULL = wildcard. Évaluées par priorité croissante.
model RoutingRule {
  id              String             @id @default(uuid())
  name            String
  priority        Int                @default(100)
  enabled         Boolean            @default(true)
  country         String?
  currency        String?
  method          PaymentMethodType?
  minAmountCents  BigInt?            @map("min_amount_cents")
  maxAmountCents  BigInt?            @map("max_amount_cents")
  merchantSegment String?            @map("merchant_segment")
  binPrefix       String?            @map("bin_prefix")
  partnerId       String             @map("partner_id")
  partner         Partner            @relation(fields: [partnerId], references: [id])
  createdAt       DateTime           @default(now()) @map("created_at")
  updatedAt       DateTime           @updatedAt @map("updated_at")

  @@index([enabled, priority])
  @@map("routing_rules")
}

// Commission TECHNOLOGIQUE facturée par AlphaPay (pas les flux de fonds bruts).
model FeeProfile {
  id          String     @id @default(uuid())
  name        String
  description String?
  isDefault   Boolean    @default(false) @map("is_default")
  rules       FeeRule[]
  merchants   Merchant[]
  createdAt   DateTime   @default(now()) @map("created_at")
  updatedAt   DateTime   @updatedAt @map("updated_at")

  @@map("fee_profiles")
}

model FeeRule {
  id             String             @id @default(uuid())
  feeProfileId   String             @map("fee_profile_id")
  feeProfile     FeeProfile         @relation(fields: [feeProfileId], references: [id], onDelete: Cascade)
  method         PaymentMethodType? // NULL = toutes méthodes
  partnerId      String?            @map("partner_id")
  minAmountCents BigInt?            @map("min_amount_cents")
  maxAmountCents BigInt?            @map("max_amount_cents")
  percentBps     Int                @default(0) @map("percent_bps")
  fixedCents     BigInt             @default(0) @map("fixed_cents")
  currency       String             @default("XAF")

  @@index([feeProfileId])
  @@map("fee_rules")
}

// MIROIR des reversements effectués par les partenaires vers les marchands.
// AlphaPay n'exécute pas le virement : on garde une trace pour réconciliation/reporting.
model SettlementRecord {
  id          String    @id @default(uuid())
  partnerId   String    @map("partner_id")
  merchantId  String    @map("merchant_id")
  externalRef String?   @map("external_ref") // référence du settlement chez le partenaire
  grossCents  BigInt    @map("gross_cents")
  feeCents    BigInt    @map("fee_cents") // notre commission techno
  netCents    BigInt    @map("net_cents") // net reversé par le partenaire
  currency    String
  settledAt   DateTime? @map("settled_at")
  createdAt   DateTime  @default(now()) @map("created_at")

  @@index([merchantId])
  @@index([partnerId])
  @@map("settlement_records")
}
