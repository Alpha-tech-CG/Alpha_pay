# Modèle d'environnement — NE JAMAIS y mettre de vraie valeur (ALP-163).
# En staging/prod, les secrets viennent d'AWS Secrets Manager (cf. ALP-139),
# jamais d'un fichier. Ce fichier ne contient QUE des placeholders.

# === DATABASE ===
# En prod : sslmode=verify-full (ALP-165)
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paybrain

# === REDIS ===
REDIS_URL=redis://localhost:6379

# === USSD (paiement depuis téléphone à touches) ===
# Shortcode partagé MTN/Airtel fourni par l'agrégateur USSD (ex. Africa's Talking).
USSD_SHORTCODE=*182#
# IP(s) de la passerelle USSD autorisées à appeler /ussd (défense en profondeur).
USSD_GATEWAY_IP_ALLOWLIST=

# === SETTLEMENT — validateurs 4-eyes (ALP-VULN) ===
# Obligatoire en production. Liste "id:secret" séparée par des virgules ; chaque
# validateur présente SON secret (en-têtes X-Validator-Id / X-Validator-Token).
# Deux validateurs DISTINCTS requis au-delà de 500 000 FCFA.
SETTLEMENT_VALIDATORS=<validator1>:<secret1>,<validator2>:<secret2>

# === MTN MoMo ===
MTN_SUBSCRIPTION_KEY=<TO_BE_FILLED>
MTN_API_USER_ID=<TO_BE_FILLED>
MTN_API_KEY=<TO_BE_FILLED>
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_ENVIRONMENT=sandbox
MTN_CURRENCY=EUR
# Produit Disbursement MTN (reversement marchand) — abonnement + API user dédiés.
MTN_DISBURSEMENT_SUBSCRIPTION_KEY=<TO_BE_FILLED>
MTN_DISBURSEMENT_API_USER_ID=<TO_BE_FILLED>
MTN_DISBURSEMENT_API_KEY=<TO_BE_FILLED>

# === AIRTEL MONEY ===
AIRTEL_CLIENT_ID=<TO_BE_FILLED>
AIRTEL_CLIENT_SECRET=<TO_BE_FILLED>
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_ENVIRONMENT=sandbox
# PIN business Airtel pour le Disbursement, DÉJÀ chiffré RSA avec la clé publique
# Airtel (jamais le PIN en clair). Requis pour les reversements via Airtel.
AIRTEL_DISBURSEMENT_PIN=<RSA_ENCRYPTED_PIN>
AIRTEL_CURRENCY=XAF

# === WEBHOOKS ===
# Générer avec: openssl rand -hex 32
PAYBRAIN_WEBHOOK_URL=https://<your-host>/webhooks/mtn
MTN_WEBHOOK_SECRET=<GENERATE_WITH_openssl_rand_-hex_32>
AIRTEL_WEBHOOK_SECRET=<GENERATE_WITH_openssl_rand_-hex_32>
# En prod, les callbacks operateurs exigent aussi une allowlist IP configuree.
MTN_WEBHOOK_IP_ALLOWLIST=<CIDR_MTN_1>,<CIDR_MTN_2>
AIRTEL_WEBHOOK_IP_ALLOWLIST=<CIDR_AIRTEL_1>,<CIDR_AIRTEL_2>
# Dev/sandbox uniquement : autorise explicitement les callbacks operateurs non signes.
ALLOW_UNSIGNED_OPERATOR_CALLBACKS=false

# === AUTH ===
JWT_SECRET=<GENERATE_WITH_openssl_rand_-base64_48>
API_KEY_SALT=<GENERATE_WITH_openssl_rand_-hex_16>
# Pepper des clés API marchand (≥32 chars), chargé depuis Secrets Manager (ALP-161)
API_KEY_PEPPER=<GENERATE_WITH_openssl_rand_-base64_32>
INTERNAL_API_TOKEN=<GENERATE_WITH_openssl_rand_-hex_32>
# Clé maître de chiffrement des PII, base64 32 octets (ALP-164)
PII_ENCRYPTION_KEY=<GENERATE_WITH_openssl_rand_-base64_32>

# === APP ===
PORT=3000
NODE_ENV=development
METRICS_TOKEN=<GENERATE_WITH_openssl_rand_-hex_32>

# === CLERK ===
# Front (dashboard) : dans dashboard/.env sous VITE_CLERK_PUBLISHABLE_KEY
VITE_CLERK_PUBLISHABLE_KEY=<pk_test_...>
# Backend : JAMAIS committer la vraie valeur. Vérifie les sessions (ClerkSessionGuard,
# @clerk/backend) ET les webhooks (ClerkWebhookGuard, décision 1A Team Members).
CLERK_SECRET_KEY=<sk_test_...>
# Clerk → Webhooks (svix). Signe les événements user.created/updated/deleted.
CLERK_WEBHOOK_SECRET=<GENERATE_FROM_CLERK_WEBHOOK_DASHBOARD>
# Base du lien d'invitation équipe marchand : "<base>?token=<clair>" (Team Members étape B).
APP_INVITE_BASE_URL=<https://dashboard.example.com/invite>

# === AWS (Secrets Manager, ALP-139) ===
AWS_REGION=eu-west-1
AWS_SECRETS_MANAGER_SECRET_ID=<paybrain/prod/env>

# === NOTIFICATIONS (ALP-143) ===
AT_API_KEY=<TO_BE_FILLED>
AT_USERNAME=<TO_BE_FILLED>
POSTMARK_TOKEN=<TO_BE_FILLED>
POSTMARK_FROM=<verified-sender@example.com>
# Secret partagé exigé sur les callbacks de délivrance fournisseurs.
NOTIFICATION_WEBHOOK_SECRET=<GENERATE_WITH_openssl_rand_-hex_32>

# === RECONCILIATION (ALP-140) ===
# Facultatif en local ; injecté automatiquement par Terraform sur ECS.
RECONCILIATION_REPORTS_BUCKET=<paybrain-prod-reconciliation-reports>
OPS_EMAIL=<ops@example.com>

# === SETTLEMENT / PAYOUT (ALP-141) ===
# Reversement MOMO : routé vers le Disbursement de l'opérateur (MTN/Airtel ci-dessus).
# PAYOUT_API_* ne sert QUE pour les reversements par virement BANCAIRE (méthode BANK).
PAYOUT_API_URL=<https://provider.example.com/v1>
PAYOUT_API_TOKEN=<TO_BE_FILLED>
SETTLEMENT_DOCUMENTS_BUCKET=<paybrain-prod-reconciliation-reports>
# KYC (ALP-142)
KYC_DOCUMENTS_BUCKET=
SMILE_API_URL=
SMILE_PARTNER_ID=
SMILE_API_KEY=
SMILE_CALLBACK_URL=https://api.example.com/webhooks/kyc/smile
SMILE_WEBHOOK_SECRET=
SANCTIONS_API_URL=
SANCTIONS_API_TOKEN=
