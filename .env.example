# === DATABASE ===
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/paybrain

# === REDIS ===
REDIS_URL=redis://localhost:6379

# === MTN MoMo ===
MTN_SUBSCRIPTION_KEY=
MTN_API_USER_ID=
MTN_API_KEY=
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_ENVIRONMENT=sandbox
MTN_CURRENCY=EUR

# === AIRTEL MONEY ===
AIRTEL_CLIENT_ID=
AIRTEL_CLIENT_SECRET=
AIRTEL_BASE_URL=https://openapiuat.airtel.africa
AIRTEL_ENVIRONMENT=sandbox

# === WEBHOOKS ===
# MTN/Airtel ne signent pas leurs callbacks : le secret dans l'URL est notre seule
# protection contre un appel forgé. Générer avec: openssl rand -hex 32
# L'URL doit pointer vers /webhooks/mtn/<MTN_WEBHOOK_SECRET>
PAYBRAIN_WEBHOOK_URL=https://your-ngrok-url.ngrok-free.dev/webhooks/mtn/__MTN_WEBHOOK_SECRET__
MTN_WEBHOOK_SECRET=
AIRTEL_WEBHOOK_SECRET=

# === AUTH ===
JWT_SECRET=
API_KEY_SALT=

# === APP ===
PORT=3000
NODE_ENV=development
# === CLERK ===
# Front (dashboard) : à mettre dans dashboard/.env sous VITE_CLERK_PUBLISHABLE_KEY
VITE_CLERK_PUBLISHABLE_KEY=pk_test_xxx
# Backend (vérification de session Clerk, plus tard) : JAMAIS committer la vraie valeur
CLERK_SECRET_KEY=sk_test_xxx
