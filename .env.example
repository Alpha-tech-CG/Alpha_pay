# =============================================================================
# AlphaPay — modèle de configuration (T-14)
# =============================================================================
# Ce fichier documente TOUTES les variables lues par l'API et le worker
# (apps/api). Il ne contient que des valeurs d'exemple : n'y mettez jamais de
# vrai secret, et ne commitez jamais de fichier .env (§2.6).
#
# - Local : `docker compose up --build` fournit déjà des valeurs de
#   développement (docker-compose.yml) ; tous les fournisseurs sont factices.
# - Préproduction / production : les secrets sont des fichiers montés
#   (SECRETS_FILE) sur le VPS, jamais des variables en clair (docs/DEPLOYMENT_VPS.md).
# - Au démarrage, l'API et le worker vérifient cette configuration et refusent
#   de démarrer en nommant chaque variable manquante ou invalide.
#
# Générer une clé base64 de 32 octets :
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
# Générer un jeton hexadécimal :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"

# --- Application -------------------------------------------------------------
# development | test | production (« production » vaut aussi pour la préproduction).
NODE_ENV=development
PORT=3000
# URL publique de l'API : URL de callback des opérateurs, liens dans les messages.
PUBLIC_API_URL=http://localhost:3000
# Origines autorisées (CORS), séparées par des virgules. Jamais « * ».
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:5180
# Base des liens de paiement hébergés (/pay/:id).
CHECKOUT_URL=http://localhost:3000
# Niveau de journal : fatal | error | warn | info | debug | trace | silent.
LOG_LEVEL=info
# Nom du service dans les journaux JSON (alphapay-api, alphapay-worker).
SERVICE_NAME=alphapay-api
# Documentation OpenAPI : active hors production ; « true » pour l'activer en production.
ENABLE_API_DOCS=false
# Fichier de secrets « CLE=valeur » monté sur le serveur (préproduction et production).
SECRETS_FILE=

# --- Base de données (PostgreSQL) ---------------------------------------------
# En production : sslmode=verify-full. Borner le pool par instance :
#   ?connection_limit=20&pool_timeout=10
DATABASE_URL=postgresql://alphapay:alphapay@localhost:5433/alphapay

# --- Redis (file de tâches, limites de débit, cache des jetons opérateur) -----
# Obligatoire en production et pour le worker.
REDIS_URL=redis://localhost:6379

# --- Chiffrement et secrets applicatifs ---------------------------------------
# Clé maîtresse des données personnelles (téléphones, emails), base64 32 octets.
PII_ENCRYPTION_KEY=<base64-32-octets>
# Clé maîtresse des identifiants opérateur des marchands, base64 32 octets,
# DISTINCTE de PII_ENCRYPTION_KEY (§4.3). Jamais stockée en base.
PROVIDER_CREDENTIALS_KEY=<base64-32-octets>
# Poivre des clés API marchand (au moins 32 caractères).
API_KEY_PEPPER=<au-moins-32-caracteres>
# Jeton des routes internes /internal (back-office), au moins 32 caractères.
INTERNAL_API_TOKEN=<au-moins-32-caracteres>
# Jeton exigé pour lire /metrics (Prometheus).
METRICS_TOKEN=<jeton-hex>

# --- Opérateurs Mobile Money (§4.3, D-006) -------------------------------------
# Les identifiants MTN et Airtel sont ceux DE CHAQUE MARCHAND, saisis dans le
# tableau de bord et stockés chiffrés (provider_connections). Aucun identifiant
# opérateur « plateforme » ici.
# Mode test : « mock » (défaut, aucun compte requis) ou « sandbox » (vrai sandbox
# opérateur pour les marchands qui y ont connecté leur compte).
MOBILE_MONEY_TEST_PROVIDER=mock
# Le sandbox MTN refuse le XAF et exige l'EUR ; la production utilise le XAF.
MTN_SANDBOX_CURRENCY=EUR
# Délai (secondes) au-delà duquel un paiement sans réponse est déclaré expiré.
PAYMENT_EXPIRY_SECONDS=600
# Préfixes opérateurs : par défaut packages/shared/src/config/operators.cg.json.
# Surcharge facultative (JSON), ex. {"MTN":["06"],"AIRTEL":["05","04"]}
PHONE_OPERATOR_PREFIXES=

# --- Callbacks opérateur entrants ---------------------------------------------
# Secret HMAC des callbacks relayés (en-têtes X-Signature-256 et X-Timestamp).
MTN_WEBHOOK_SECRET=<jeton-hex>
AIRTEL_WEBHOOK_SECRET=<jeton-hex>
# Plages IP autorisées (CIDR, séparées par des virgules) ; obligatoires en production.
MTN_WEBHOOK_IP_ALLOWLIST=
AIRTEL_WEBHOOK_IP_ALLOWLIST=
# « true » pour exiger l'allowlist IP hors production.
REQUIRE_WEBHOOK_IP_ALLOWLIST=false

# --- Carte bancaire (M13, désactivée par défaut) --------------------------------
FEATURE_CARD_PAYMENTS=false

# --- Messages et OTP (M9) -------------------------------------------------------
# Fournisseurs : factices par défaut (ce qu'ils « envoient » est visible en dev
# sur GET /dev/outbox, jamais en production).
SMS_PROVIDER=mock
WHATSAPP_PROVIDER=mock
EMAIL_PROVIDER=mock
# SMS via Infobip (D-009) : URL propre au compte, clé API, nom d'expéditeur.
INFOBIP_BASE_URL=
INFOBIP_API_KEY=
SMS_SENDER_ID=AlphaPay
# WhatsApp Cloud API de Meta : numéro, jeton, secret d'application (signature
# des webhooks) et jeton de vérification de l'abonnement au webhook.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_APP_SECRET=
WHATSAPP_VERIFY_TOKEN=
WHATSAPP_API_VERSION=v21.0
# Email via SMTP générique (D-010) : Brevo, Amazon SES ou Resend ; MailHog en local.
SMTP_URL=smtp://localhost:1025
EMAIL_FROM=AlphaPay <no-reply@alphapay.cg>
# Jeton secret des URL d'accusés Infobip (/webhooks/messages/infobip?token=…).
MESSAGING_WEBHOOK_TOKEN=<jeton-hex>
# Crédits consommés par canal (JSON), ex. {"SMS":1,"WHATSAPP":1,"EMAIL":1}.
MESSAGE_CREDIT_COSTS=
# « false » pour désactiver la boîte d'envoi de développement.
DEV_OUTBOX_ENABLED=true

# --- Notifications héritées (remplacées par M9, retirées avec M1/M2) ------------
# SMS via Africa's Talking (adaptateur hérité, remplacé par Infobip, D-009).
AT_API_KEY=
AT_USERNAME=
# Email via Postmark (adaptateur hérité, remplacé par SMTP générique, D-010).
POSTMARK_TOKEN=
POSTMARK_FROM=
# Secret partagé exigé sur les accusés de livraison des fournisseurs.
NOTIFICATION_WEBHOOK_SECRET=<jeton-hex>
# Destinataire des alertes d'exploitation.
OPS_EMAIL=

# --- Authentification du tableau de bord (Clerk, retiré avec T-30, D-005) -----
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SECRET=
# Base du lien d'invitation d'équipe : « <base>?token=<jeton> ».
APP_INVITE_BASE_URL=http://localhost:5174/invite
# Front (dashboard/.env et admin/.env) : clé publique Clerk.
VITE_CLERK_PUBLISHABLE_KEY=

# --- KYC (remplacé par Sumsub + mock, T-60) -------------------------------------
# Bucket S3 compatible des pièces (chiffrement côté serveur, URL signées).
KYC_DOCUMENTS_BUCKET=
SMILE_API_URL=
SMILE_PARTNER_ID=
SMILE_API_KEY=
SMILE_CALLBACK_URL=
SMILE_WEBHOOK_SECRET=
SANCTIONS_API_URL=
SANCTIONS_API_TOKEN=

# --- Rapprochement ----------------------------------------------------------------
# Bucket des rapports PDF et répertoire des relevés à importer automatiquement.
RECONCILIATION_REPORTS_BUCKET=
RECONCILIATION_INBOX=

# --- Observabilité (§8.4) ---------------------------------------------------------
# Suivi des erreurs (D-011) ; vide = désactivé.
SENTRY_DSN=
# Export des traces OpenTelemetry (ex. http://localhost:4318).
OTEL_EXPORTER_OTLP_ENDPOINT=

# --- Secrets AWS (hérité, hébergement AWS abandonné, D-015) -------------------------
AWS_REGION=
AWS_SECRETS_MANAGER_SECRET_ID=
