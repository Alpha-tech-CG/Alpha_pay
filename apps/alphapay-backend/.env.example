# ─── APP ───────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
APP_URL=http://localhost:3000
FRONTEND_URL=http://localhost:3001

# ─── DATABASE ──────────────────────────────────────────────────
DATABASE_URL=postgresql://alphapay:alphapay@localhost:5432/alphapay_db
DB_HOST=localhost
DB_PORT=5432
DB_NAME=alphapay_db
DB_USER=alphapay
DB_PASSWORD=alphapay

# ─── REDIS ─────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379
REDIS_HOST=localhost
REDIS_PORT=6379

# ─── JWT ───────────────────────────────────────────────────────
JWT_ACCESS_SECRET=REPLACE_WITH_RANDOM_256BIT_SECRET
JWT_REFRESH_SECRET=REPLACE_WITH_RANDOM_256BIT_SECRET
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ─── ENCRYPTION (AES-256-GCM for PII) ─────────────────────────
# 32-byte key as 64 hex chars. Generate: openssl rand -hex 32
ENCRYPTION_KEY=REPLACE_WITH_RANDOM_32_BYTE_HEX

# ─── ADMIN BACK-OFFICE ─────────────────────────────────────────
# Jeton du plan admin (header x-admin-token), séparé du JWT utilisateur. >= 16 car.
ADMIN_API_TOKEN=REPLACE_WITH_RANDOM_ADMIN_TOKEN

# ─── MTN MOMO ──────────────────────────────────────────────────
MTN_USE_STUB=true
MTN_API_USER=REPLACE_WHEN_READY
MTN_API_KEY=REPLACE_WHEN_READY
MTN_SUBSCRIPTION_KEY=REPLACE_WHEN_READY
MTN_ENVIRONMENT=sandbox
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com

# ─── AIRTEL MONEY ──────────────────────────────────────────────
AIRTEL_USE_STUB=true
AIRTEL_CLIENT_ID=REPLACE_WHEN_READY
AIRTEL_CLIENT_SECRET=REPLACE_WHEN_READY
AIRTEL_BASE_URL=https://openapiuat.airtel.africa

# ─── LIBYAN BANKS ──────────────────────────────────────────────
LIBYAN_BANK_USE_STUB=true
WAHDA_BANK_API_KEY=REPLACE_WHEN_READY
WAHDA_BANK_BASE_URL=REPLACE_WHEN_READY
BCD_BANK_API_KEY=REPLACE_WHEN_READY
BCD_BANK_BASE_URL=REPLACE_WHEN_READY

# ─── CIRCLE (USDC BRIDGE) ──────────────────────────────────────
CIRCLE_USE_STUB=true
CIRCLE_API_KEY=REPLACE_WHEN_READY
CIRCLE_BASE_URL=https://api-sandbox.circle.com

# ─── CARD ISSUERS ──────────────────────────────────────────────
UNION54_USE_STUB=true
UNION54_API_KEY=REPLACE_WHEN_READY
UNION54_BASE_URL=REPLACE_WHEN_READY

UNLIMINT_USE_STUB=true
UNLIMINT_API_KEY=REPLACE_WHEN_READY
UNLIMINT_SECRET=REPLACE_WHEN_READY
UNLIMINT_BASE_URL=https://sandbox.cardpay.com

# ─── WISE ──────────────────────────────────────────────────────
WISE_USE_STUB=true
WISE_API_TOKEN=REPLACE_WHEN_READY
WISE_BASE_URL=https://api.sandbox.transferwise.tech

# ─── KYC ───────────────────────────────────────────────────────
SMILE_USE_STUB=true
SMILE_PARTNER_ID=REPLACE_WHEN_READY
SMILE_API_KEY=REPLACE_WHEN_READY

SUMSUB_USE_STUB=true
SUMSUB_APP_TOKEN=REPLACE_WHEN_READY
SUMSUB_SECRET_KEY=REPLACE_WHEN_READY

# ─── AFRICA'S TALKING (USSD) ───────────────────────────────────
AT_USE_STUB=true
AT_API_KEY=REPLACE_WHEN_READY
AT_USERNAME=REPLACE_WHEN_READY
AT_USSD_CODE=*150*REPLACE#

# ─── NOTIFICATIONS (SMS + EMAIL) ───────────────────────────────
NOTIFY_USE_STUB=true          # false => SMS via Africa's Talking (AT_*) + email via SendGrid
SENDGRID_API_KEY=REPLACE_WHEN_READY
EMAIL_FROM=noreply@alphapay.co
SMS_SENDER_ID=AlphaPay

# ─── FX RATES ──────────────────────────────────────────────────
FX_USE_STUB=true
CURRENCYLAYER_API_KEY=REPLACE_WHEN_READY
FX_CACHE_TTL_SECONDS=300
