# =============================================================================
# PayBrain — .env.example (DEV LOCAL UNIQUEMENT)
# =============================================================================
# ⚠ EN PRODUCTION : tous les secrets viennent d'AWS Secrets Manager,
#   PAS de ce fichier. Voir lib/secrets.js.
# ⚠ Ne JAMAIS committer un .env réel (le .gitignore le bloque, et Gitleaks scanne).
# ⚠ Tous les secrets doivent être générés aléatoirement, jamais inspirés de mots.
#
# Génération recommandée (à exécuter localement) :
#   openssl rand -base64 48          # API_KEY_PEPPER, DETERMINISTIC_HMAC_KEY_B64
#   openssl rand -hex 32             # MTN_WEBHOOK_SECRET (côté MTN, on enregistre la même)
#
# =============================================================================

NODE_ENV=development
PORT=3000
APP_VERSION=0.2.0-secure
LOG_LEVEL=info

# Origines autorisées (allowlist CORS, séparées par virgules)
ALLOWED_ORIGINS=http://localhost:5173

# URL publique utilisée pour les callbacks MTN (DOIT être HTTPS en prod)
PUBLIC_BASE_URL=http://localhost:3000

# -----------------------------------------------------------------------------
# Base de données — TLS obligatoire en prod (sslmode=verify-full)
# -----------------------------------------------------------------------------
DATABASE_URL=postgresql://paybrain_app:<DEV_PASSWORD>@localhost:5432/paybrain
REDIS_URL=redis://localhost:6379

# -----------------------------------------------------------------------------
# Peppers / clés crypto — minimum 32 caractères, JAMAIS basés sur des mots
# -----------------------------------------------------------------------------
API_KEY_PEPPER=<GENERATE_WITH_openssl_rand_base64_48>
DETERMINISTIC_HMAC_KEY_B64=<GENERATE_WITH_openssl_rand_base64_32>
KMS_KEY_ID=alias/paybrain-dev

# -----------------------------------------------------------------------------
# MTN MoMo (SANDBOX uniquement en dev)
# -----------------------------------------------------------------------------
MTN_BASE_URL=https://sandbox.momodeveloper.mtn.com
MTN_ENVIRONMENT=sandbox
MTN_SUBSCRIPTION_KEY=<TO_BE_FILLED>
MTN_API_USER_ID=<TO_BE_FILLED>
MTN_API_KEY=<TO_BE_FILLED>

# Secret HMAC partagé avec MTN pour signer les webhooks entrants
MTN_WEBHOOK_SECRET=<GENERATE_WITH_openssl_rand_hex_32>
