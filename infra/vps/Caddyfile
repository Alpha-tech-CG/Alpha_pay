# Reverse proxy TLS d'AlphaPay (certificats Let's Encrypt automatiques).
#
# Caddy est l'UNIQUE proxy devant l'API : il écrase tout X-Forwarded-For fourni
# par le client, ce qui garde fiable `trust proxy = 1` côté API (allowlists IP
# des webhooks opérateurs, rate-limit par IP). Si un CDN/WAF est ajouté devant,
# déclarer ses plages dans `trusted_proxies` ET revoir `trust proxy` dans main.ts.
#
# Quatre sites (enregistrements DNS A vers le VPS avant le premier démarrage) :
#   API_DOMAIN        API publique (/v1), webhooks opérateurs et fournisseurs
#   PAY_DOMAIN        page de paiement hébergée et QR (/l/…, /c/…), reçus (/v1/public)
#   DASHBOARD_DOMAIN  tableau de bord marchand (PWA), API relayée sous /api
#   ADMIN_DOMAIN      back-office, API relayée sous /admin-api, IP filtrées
{
	email {$ACME_EMAIL}
}

(security_headers) {
	header {
		Strict-Transport-Security "max-age=63072000; includeSubDomains; preload"
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
		-Server
	}
}

(spa) {
	encode zstd gzip
	# Le service worker et la page d'entrée ne sont jamais mis en cache ; les
	# fichiers versionnés (assets/…) le sont un an.
	@immutable path /assets/*
	header @immutable Cache-Control "public, max-age=31536000, immutable"
	@fresh path / /index.html /sw.js /manifest.webmanifest
	header @fresh Cache-Control "no-cache"
	try_files {path} /index.html
	file_server
}

{$API_DOMAIN} {
	import security_headers
	encode zstd gzip

	# /metrics n'est scrapé qu'en interne (réseau Docker), jamais depuis Internet.
	@metrics path /metrics /metrics/*
	respond @metrics 404

	# Plafond aligné sur le plus gros corps accepté par l'API (pièce KYB 10 Mo).
	request_body {
		max_size 11MB
	}

	reverse_proxy api:3000
}

{$PAY_DOMAIN} {
	import security_headers
	encode zstd gzip
	@pay path /l/* /c/* /checkout/* /v1/public/*
	handle @pay {
		reverse_proxy api:3000
	}
	handle {
		respond 404
	}
}

{$DASHBOARD_DOMAIN} {
	import security_headers
	request_body {
		max_size 11MB
	}
	# Même origine que la PWA : pas de CORS ; le cookie de session (Path=/v1/auth
	# côté API) est réécrit pour le chemin vu par le navigateur.
	handle_path /api/* {
		reverse_proxy api:3000 {
			header_down Set-Cookie "Path=/v1/auth" "Path=/api/v1/auth"
		}
	}
	handle {
		root * /srv/dashboard
		import spa
	}
}

{$ADMIN_DOMAIN} {
	import security_headers
	# Back-office réservé au réseau d'AlphaPay (§M12) : IP ou plages autorisées.
	@outside not remote_ip {$ADMIN_ALLOWED_IPS}
	respond @outside 403
	handle_path /admin-api/* {
		reverse_proxy api:3000
	}
	handle {
		root * /srv/admin
		import spa
	}
}
