# Variables NON secrètes du compose de production (copier en infra/vps/vps.env).
# Les secrets vont dans infra/vps/secrets/ — jamais ici.

# Domaines publics : leurs enregistrements DNS A doivent pointer sur l'IP du VPS
# AVANT le premier démarrage (sinon Let's Encrypt échoue).
# API publique, webhooks des opérateurs et des fournisseurs de messages.
API_DOMAIN=api.alphapay.cg
# Page de paiement hébergée et QR des caisses (reporter dans CHECKOUT_URL).
PAY_DOMAIN=pay.alphapay.cg
# Tableau de bord marchand (PWA).
DASHBOARD_DOMAIN=app.alphapay.cg
# Back-office du personnel AlphaPay.
ADMIN_DOMAIN=admin.alphapay.cg
# IP ou plages CIDR autorisées sur le back-office, séparées par des espaces.
ADMIN_ALLOWED_IPS=203.0.113.10/32

# Adresse de contact pour les certificats Let's Encrypt.
ACME_EMAIL=ops@example.com

# Tag de l'image API construite localement.
API_IMAGE_TAG=local
