# pnpm — migration compatible + durcissement supply-chain (2026-08).
# Arborescence plate façon npm : évite les cassures liées aux symlinks pnpm
# (modules natifs argon2, Windows, deps « fantômes » du monorepo).
node-linker=hoisted

# Compatibilité : rester tolérant sur les peer deps comme npm l'était, pour ne
# pas bloquer l'install sur des peers manquants pendant la migration.
strict-peer-dependencies=false
auto-install-peers=true

# Sécurité : les scripts d'install des dépendances sont bloqués par défaut
# (pnpm 10+). Seuls les paquets listés à `true` dans pnpm-workspace.yaml >
# allowBuilds (argon2, prisma, @prisma/*, sharp) exécutent leurs scripts de build.

# Lier les paquets internes du monorepo depuis le workspace, pas le registry.
link-workspace-packages=true
